@{
    // ✅ Flags de roles para controlar menú
    bool isAuth = (Request != null && Request.IsAuthenticated);
    bool esAdmin = (User != null && User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"));
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MiMundoHuellitas</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/StaticFiles/css/style.css" rel="stylesheet" />
    <link href="~/StaticFiles/css/responsive.css" rel="stylesheet" />
    <link href="~/StaticFiles/fonts/font-awesome.min.css" rel="stylesheet" />
    <link href="~/StaticFiles/CSS/mimundo.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/StaticFiles/CSS/animaciones.css" />

    <style>
        /* Footer pegado abajo */
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main.container-fluid.body-content {
            flex: 1;
        }

        /* Barra celestita */
        .top-contact-bar {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            padding: 8px 0;
            color: #fff;
            font-size: 0.9rem;
        }

        .top-contact-inner {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 12px;
            /* Usar Flex para distribuir los elementos */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-contact-left span {
            display: inline-flex;
            align-items: center;
        }

        .top-contact-left i {
            margin-right: 5px;
        }

        /* Ajuste: Contenedor derecho de la barra celeste */
        .top-contact-right {
            display: flex;
            align-items: center; /* Alinear verticalmente todos los elementos */
        }

            /* Ajuste: Estilo para los enlaces de sesión/perfil en la barra celeste */
            .top-contact-right a.auth-link {
                color: #fff; /* Enlaces blancos */
                margin-left: 15px; /* Separación entre enlaces */
                white-space: nowrap; /* Evita que el texto se rompa */
                text-decoration: none; /* Asegura que no tengan subrayado */
            }

            .top-contact-right .user-greeting {
                color: #fff;
                margin-left: 15px;
                white-space: nowrap;
            }

            /* Iconos de redes sociales */
            .top-contact-right a.social-icon {
                font-size: 1.2rem;
                margin-left: 15px; /* Separación de las redes sociales */
            }


        /* Menú principal */
        .menu-principal .nav-link {
            text-transform: uppercase;
            font-weight: 600;
            font-size: 0.85rem;
            margin-left: 0.75rem;
            white-space: nowrap;
        }

            .menu-principal .nav-link.active {
                color: #00c853 !important;
            }

        /* Alinear mejor logo y texto */
        .menu-principal .navbar-brand {
            display: flex;
            align-items: center;
        }

            .menu-principal .navbar-brand img {
                height: 40px;
            }

            .menu-principal .navbar-brand span {
                line-height: 1;
            }
    </style>
    
    <!-- Linea para incluir fontsawesome, pls no tocar-->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-..."
          crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body class="has-fixed-nav">

    <div class="top-contact-bar">
        <div class="top-contact-inner">
            <div class="top-contact-left">
                <span>
                    <i class="fa fa-phone"></i> +506 7263-7460
                </span>
                <span class="ms-3">
                    <i class="fa fa-envelope"></i> mundodehuellitascr@outlook.com
                </span>
            </div>

            <div class="top-contact-right">
                @* Lógica de Autenticación Movida Aquí *@
                @if (isAuth)
                {
                    <span class="user-greeting">Hola, @User.Identity.Name</span>

                    @* ✅ ADMIN: solo cerrar sesión (sin carrito/perfil/citas) *@
                    if (esAdmin)
                    {
                        @Html.ActionLink("Cerrar sesión", "Logout", "Account", null, new { @class = "auth-link" })
                        @Html.ActionLink("Mi perfil", "Perfil", "Usuario", null, new { @class = "auth-link" })
                    }
                    else
                    {
                        @* ✅ CLIENTE: mantiene lo que ya tenías *@
                        <a class="auth-link" href="@Url.Action("Carrito", "Productos")" title="Carrito">
                            <i class="fa fa-shopping-cart"></i>
                        </a>

                        @Html.ActionLink("Mi perfil", "Perfil", "Usuario", null, new { @class = "auth-link" })
                        @Html.ActionLink("Mis citas", "VerCitas", "Citas", null, new { @class = "auth-link" })
                        @Html.ActionLink("Cerrar sesión", "Logout", "Account", null, new { @class = "auth-link" })
                    }
                }
                else
                {
                    @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "auth-link" })
                }

                @* Redes Sociales *@
                <a href="#" class="social-icon text-white" aria-label="Facebook">
                    <i class="fa fa-facebook"></i>
                </a>
                <a href="#" class="social-icon text-white" aria-label="Instagram">
                    <i class="fa fa-instagram"></i>
                </a>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom menu-principal sticky-top">
        <div class="container">

            <a class="navbar-brand" href="@Url.Action("Index","Home")">
                <img src="~/StaticFiles/img/Huellitas.png" alt="Logo" />
                <span class="ms-2 fw-bold">Mi Mundo de Huellitas</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu"
                    aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    @* ✅ ADMIN: SOLO REPORTES (como pediste "de momento") *@
                    @if (esAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Reportes" ? "active" : "")"
                               href="@Url.Action("Index", "Reportes")">REPORTES</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "AdminUsuarios")">
                                ADMIN USUARIOS
                            </a>
                        </li>
                    }
                    else
                    {
                        @* ✅ CLIENTE/PÚBLICO: menú normal *@
                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Inicio" ? "active" : "")"
                               href="@Url.Action("Index","Home")">INICIO</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Nosotros" ? "active" : "")"
                               href="@Url.Action("SobreNosotros","Home")">SOBRE NOSOTROS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Equipo" ? "active" : "")"
                               href="@Url.Action("Equipo","Home")">EQUIPO</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Servicios" ? "active" : "")"
                               href="@Url.Action("Servicios","Home")">SERVICIOS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Galeria" ? "active" : "")"
                               href="@Url.Action("Galeria","Home")">GALERÍA</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Productos" ? "active" : "")"
                               href="@Url.Action("Catalogo","Productos")">PRODUCTOS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Blog" ? "active" : "")"
                               href="@Url.Action("Blog","Home")">BLOG</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Contacto" ? "active" : "")"
                               href="@Url.Action("Contacto","Home")">CONTÁCTENOS</a>
                        </li>

                        @* ✅ Opciones solo para usuarios autenticados (clientes) *@
                        if (isAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.ActiveMenu=="AgendarCita" ? "active" : "")"
                                   href="@Url.Action("Agendar", "Citas")">AGENDAR CITA</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.ActiveMenu=="MisMascotas" ? "active" : "")"
                                   href="@Url.Action("VerMascotas", "Mascota")">MIS MASCOTAS</a>
                            </li>
                        }

                        @* ❌ Reportes NO para cliente *@

                    }

                </ul>
            </div>
        </div>
    </nav>

    @RenderSection("FullWidthTop", required: false)

    <main class="container-fluid body-content px-3">
        @RenderBody()
        <hr />
        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year - MiMundoHuellitas</p>
        </footer>
    </main>

    @RenderSection("FullWidthBottom", required: false)

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>