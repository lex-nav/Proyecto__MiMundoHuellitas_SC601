@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MiMundoHuellitas</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- CSS plantilla -->
    <link href="~/StaticFiles/css/style.css" rel="stylesheet" />
    <link href="~/StaticFiles/css/responsive.css" rel="stylesheet" />

    <!-- Iconos -->
    <link href="~/StaticFiles/fonts/font-awesome.min.css" rel="stylesheet" />

    <!-- CSS propio -->
    <link href="~/StaticFiles/CSS/mimundo.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/StaticFiles/CSS/animaciones.css" />

    <style>
        /* =========================================
           LAYOUT: Footer al fondo SIN romper scroll
           (no usamos body:flex porque la plantilla hero/fullscreen se rompe)
        ========================================== */
        html, body {
            height: 100%;
        }

        body {
            overflow-y: auto;
        }

        .page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .page-content {
            flex: 1 0 auto;
        }

        footer.site-footer {
            flex-shrink: 0;
            padding: 18px 0;
            background: #fff;
            border-top: 1px solid rgba(0,0,0,.07);
        }

        /* =========================================
           Barra celestita (izq contacto / der redes)
        ========================================== */
        .top-contact-bar {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            padding: 8px 0;
            color: #fff;
            font-size: 0.9rem;
        }

            .top-contact-bar .top-contact-left span i {
                margin-right: 6px;
            }

        .top-contact-right a {
            color: #fff;
            font-size: 1.15rem;
            margin-left: 12px;
            text-decoration: none;
            opacity: .95;
        }

            .top-contact-right a:hover {
                opacity: 1;
            }

        /* =========================================
           Menú principal
        ========================================== */
        .menu-principal .nav-link {
            text-transform: uppercase;
            font-weight: 600;
            font-size: 0.85rem;
            margin-left: 0.75rem;
            white-space: nowrap;
        }

            .menu-principal .nav-link.active {
                color: #00c853 !important;
            }

        .menu-principal .navbar-brand {
            display: flex;
            align-items: center;
        }

            .menu-principal .navbar-brand img {
                height: 40px;
            }

            .menu-principal .navbar-brand span {
                line-height: 1;
            }

        /* Botón tipo pastilla */
        .menu-principal .nav-link.btn-pill {
            background: #00c853;
            color: #fff !important;
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 700;
            margin-left: 10px;
        }

            .menu-principal .nav-link.btn-pill:hover {
                background: #00b44a;
                color: #fff !important;
            }

        /* Fix: a veces la plantilla intenta centrar/nav colapsa raro */
        .navbar-brand {
            margin-right: auto !important;
        }

        /* =========================================
           Loader: evitar que tape la pantalla si el JS falla
        ========================================== */
        #ftco-loader {
            display: none !important;
        }
    </style>
</head>

<body class="has-fixed-nav">
    <div class="page-wrapper">

        <!-- 1) BARRA SUPERIOR GRIS -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark px-3">
            <div class="container-fluid">

                <!-- IZQUIERDA -->
                @Html.ActionLink("Mi Mundo de Huellitas", "Index", "Home", null, new { @class = "navbar-brand" })

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#topAccountBar"
                        aria-controls="topAccountBar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- DERECHA -->
                <div class="collapse navbar-collapse" id="topAccountBar">
                    <ul class="navbar-nav ml-auto">
                        @if (Request.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="navbar-text mr-3">Hola, @User.Identity.Name</span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Carrito", "Productos")" title="Carrito">
                                    <i class="fa fa-shopping-cart"></i>
                                </a>
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink("Mi perfil", "Perfil", "Usuario", null, new { @class = "nav-link" })
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink("Mis citas", "VerCitas", "Citas", null, new { @class = "nav-link" })
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink("Cerrar sesión", "Logout", "Account", null, new { @class = "nav-link" })
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "nav-link" })
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- 2) BARRA CELESTE (contacto + redes) -->
        <div class="top-contact-bar">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="top-contact-left">
                    <span><i class="fa fa-phone"></i> +506 7263-7460</span>
                    <span class="ml-3"><i class="fa fa-envelope"></i> mundodehuellitascr@outlook.com</span>
                </div>

                <div class="top-contact-right">
                    <a href="#" title="Facebook"><i class="fa fa-facebook"></i></a>
                    <a href="#" title="Instagram"><i class="fa fa-instagram"></i></a>
                    <a href="#" title="WhatsApp"><i class="fa fa-whatsapp"></i></a>
                </div>
            </div>
        </div>

        <!-- 3) MENÚ PRINCIPAL BLANCO -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom menu-principal sticky-top">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand" href="@Url.Action("Index","Home")">
                    <img src="~/StaticFiles/img/Huellitas.png" alt="Logo" />
                    <span class="ml-2 font-weight-bold">Mi Mundo de Huellitas</span>
                </a>

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainMenu"
                        aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav ml-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Inicio" ? "active" : "")"
                               href="@Url.Action("Index","Home")">INICIO</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Nosotros" ? "active" : "")"
                               href="@Url.Action("SobreNosotros","Home")">SOBRE NOSOTROS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Equipo" ? "active" : "")"
                               href="@Url.Action("Equipo","Home")">EQUIPO</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Servicios" ? "active" : "")"
                               href="@Url.Action("Servicios","Home")">SERVICIOS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Galeria" ? "active" : "")"
                               href="@Url.Action("Galeria","Home")">GALERÍA</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Productos" ? "active" : "")"
                               href="@Url.Action("Productos","Home")">PRODUCTOS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Blog" ? "active" : "")"
                               href="@Url.Action("Blog","Home")">BLOG</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewBag.ActiveMenu=="Contacto" ? "active" : "")"
                               href="@Url.Action("Contacto","Home")">CONTÁCTENOS</a>
                        </li>

                        @if (Request.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-pill @(ViewBag.ActiveMenu=="AgendarCita" ? "active" : "")"
                                   href="@Url.Action("Agendar","Citas")">AGENDAR CITA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewBag.ActiveMenu=="MisMascotas" ? "active" : "")"
                                   href="@Url.Action("VerMascotas","Mascota")">MIS MASCOTAS</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <div class="page-content">
            @RenderBody()
        </div>

        <footer class="site-footer text-center">
            <div class="container">
                <p class="mb-0">&copy; @DateTime.Now.Year - MiMundoHuellitas</p>
            </div>
        </footer>

    </div>

    <!-- JS base -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <!-- Si el proyecto no trae popper por bundle, descomentá esto:
    <script src="~/StaticFiles/JS/popper.min.js"></script>
    -->

    @RenderSection("scripts", required: false)
</body>
</html>
