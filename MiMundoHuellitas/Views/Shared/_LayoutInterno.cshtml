@{
    bool isAuth = User.Identity.IsAuthenticated;

    int tempTipo;
    int? idTipoUsuario = null;

    if (Session["IdTipoUsuario"] != null &&
        int.TryParse(Session["IdTipoUsuario"].ToString(), out tempTipo))
    {
        idTipoUsuario = tempTipo;
    }

    bool esCliente = idTipoUsuario == 1;
    bool esAdmin = idTipoUsuario == 2;
    bool esEmpleado = idTipoUsuario == 3;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MiMundoHuellitas</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/StaticFiles/css/style.css" rel="stylesheet" />
    <link href="~/StaticFiles/css/responsive.css" rel="stylesheet" />
    <link href="~/StaticFiles/CSS/mimundo.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/StaticFiles/CSS/animaciones.css" />
    <link href="~/StaticFiles/CSS/chatbot.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main.container-fluid.body-content {
            flex: 1;
        }

        .top-contact-bar {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            padding: 8px 0;
            color: #fff;
            font-size: 0.9rem;
        }

        .top-contact-inner {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-contact-left span {
            display: inline-flex;
            align-items: center;
        }

        .top-contact-left i {
            margin-right: 6px;
        }

        .top-contact-right {
            display: flex;
            align-items: center;
        }

            .top-contact-right a.auth-link,
            .top-contact-right .user-greeting {
                color: #fff;
                margin-left: 15px;
                white-space: nowrap;
                text-decoration: none;
            }

            .top-contact-right a.social-icon {
                font-size: 1.2rem;
                margin-left: 15px;
                color: #fff;
            }

        .menu-principal .nav-link {
            text-transform: uppercase;
            font-weight: 600;
            font-size: 0.85rem;
            margin-left: 0.75rem;
            white-space: nowrap;
        }

            .menu-principal .nav-link.active {
                color: #00c853 !important;
            }

        .menu-principal .navbar-brand {
            display: flex;
            align-items: center;
        }

            .menu-principal .navbar-brand img {
                height: 40px;
            }

        .menu-principal .nav-item.dropdown {
            position: relative;
        }

        .menu-principal .dropdown-menu {
            border: none;
            border-radius: 10px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
            padding: 8px 0;
            margin-top: 0;
            top: 100%;
            left: 0;
            min-width: 220px;
        }

        .menu-principal .dropdown-item {
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            padding: 10px 18px;
            transition: all 0.2s ease;
        }

            .menu-principal .dropdown-item:hover,
            .menu-principal .dropdown-item:focus {
                background-color: #f3fdf6;
                color: #00c853;
            }

        .menu-principal .dropdown-toggle::after {
            margin-left: 6px;
            vertical-align: middle;
        }

        @@media (min-width: 992px) {
            .menu-principal .nav-item.dropdown:hover > .dropdown-menu {
                display: block;
            }
        }

        @@media (max-width: 991px) {
            .menu-principal .nav-link {
                margin-left: 0;
            }

            .menu-principal .dropdown-menu {
                box-shadow: none;
                margin-top: 0;
                border-radius: 8px;
                min-width: 100%;
            }

            .menu-principal .dropdown-item {
                padding-left: 1rem;
            }
        }
    </style>
</head>
<body class="has-fixed-nav">

    <div class="top-contact-bar">
        <div class="top-contact-inner">

            <div class="top-contact-left">
                <span><i class="fa-solid fa-phone"></i> +506 7263-7460</span>
                <span class="ms-3"><i class="fa-solid fa-envelope"></i> mundodehuellitascr@outlook.com</span>
            </div>

            <div class="top-contact-right">
                @if (isAuth)
                {
                    <span class="user-greeting">Hola, @User.Identity.Name</span>

                    @Html.ActionLink("Mi perfil", "Perfil", "Usuario", null, new { @class = "auth-link" })

                    if (esCliente)
                    {
                        <a class="auth-link" href="@Url.Action("Cart", "Carrito")" title="Carrito">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </a>

                        @Html.ActionLink("Mis citas", "VerCitas", "Citas", null, new { @class = "auth-link" })
                    }

                    <form action="@Url.Action("Logout", "Account")" method="post" id="logoutFormGeneral" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <a href="javascript:void(0);" class="auth-link"
                           onclick="document.getElementById('logoutFormGeneral').submit();">
                            Cerrar sesión
                        </a>
                    </form>
                }
                else
                {
                    @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "auth-link" })
                }

                <a href="https://www.facebook.com/share/18kic7TXwU/"
                   class="social-icon"
                   aria-label="Facebook"
                   target="_blank"
                   rel="noopener noreferrer">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom menu-principal sticky-top">
        <div class="container">

            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/StaticFiles/img/Huellitas.png" alt="Logo" />
                <span class="ms-2 fw-bold">Mi Mundo de Huellitas</span>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav ml-auto">

                    @if (esAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Reportes")">REPORTES</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("AdminPlanillas", "Planilla")">ADMIN PLANILLA</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Calcular", "Planilla")">CALCULAR PLANILLA</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("LaboralIndex", "Personal")">PERSONAL</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="dropdownAdministracion"
                               role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                ADMINISTRACIÓN
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownAdministracion">
                                <a class="dropdown-item" href="@Url.Action("Index", "AdminUsuarios")">ADMIN USUARIOS</a>
                                <a class="dropdown-item" href="@Url.Action("Index", "AdminProductos")">ADMIN PRODUCTOS</a>
                                <a class="dropdown-item" href="@Url.Action("Administrar", "Permiso")">ADMIN PERMISOS</a>
                                <a class="dropdown-item" href="@Url.Action("Index", "Auditoria")">AUDITORÍA</a>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="dropdownOperacion"
                               role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                OPERACIÓN
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownOperacion">
                                <a class="dropdown-item" href="@Url.Action("VerMascotas", "Mascota")">ADMIN MASCOTAS</a>
                            </div>
                        </li>
                    }
                    else if (esEmpleado)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">INICIO</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("MisPermisos", "Permiso")">MIS PERMISOS</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("MisPlanillas", "Planilla")">PLANILLA</a></li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="dropdownInicio"
                               role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                INICIO
                            </a>

                            <div class="dropdown-menu" aria-labelledby="dropdownInicio">
                                <a class="dropdown-item" href="@Url.Action("SobreNosotros", "Home")">SOBRE NOSOTROS</a>
                                <a class="dropdown-item" href="@Url.Action("Equipo", "Home")">EQUIPO</a>
                                <a class="dropdown-item" href="@Url.Action("Servicios", "Home")">SERVICIOS</a>
                                <a class="dropdown-item" href="@Url.Action("Galeria", "Home")">GALERIA</a>
                                <a class="dropdown-item" href="@Url.Action("Productos", "Home")">PRODUCTOS</a>
                                <a class="dropdown-item" href="@Url.Action("Blog", "Home")">BLOG</a>
                                <a class="dropdown-item" href="@Url.Action("Contacto", "Home")">CONTACTENOS</a>
                            </div>
                        </li>

                        if (isAuth)
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Agendar", "Citas")">AGENDAR CITA</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("VerMascotas", "Mascota")">MIS MASCOTAS</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Sugerencias", "Sugerencias")">SUGERENCIAS</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Promociones")">PROMOCIONES</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Recordatorios")">RECORDATORIOS</a></li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>

    @RenderSection("FullWidthTop", required: false)

    <main class="container-fluid body-content px-3">
        @RenderBody()
        <hr />
        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year - MiMundoHuellitas</p>
        </footer>
    </main>

    @RenderSection("FullWidthBottom", required: false)

    <!-- 🐾 HUELLITAS BOT -->
    <div id="chat-bubble">
        <i class="fa-solid fa-paw"></i>
    </div>

    <div id="chat-window" class="hidden">
        <div id="chat-header">
            🐾 HuellitasBot
            <span id="close-chat">✖</span>
        </div>

        <div id="chat-body">
            <div class="bot-message">
                ¡Hola! Bienvenido a Mi Mundo Huellitas 🐶
                ¿Cómo puedo ayudarte hoy?
            </div>

            <div class="options">
                <button onclick="respuesta(1)">¿Cómo agendar?</button>
                <button onclick="respuesta(2)">Cuáles servicios ofrecemos?</button>
                <button onclick="respuesta(3)">Horarios</button>
                <button onclick="respuesta(4)">Ubicación</button>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script src="~/StaticFiles/JS/chatbot.js"></script>

</body>
</html>
