@model IEnumerable<MiMundoHuellitas.Models.ViewModels.PlanillaDetalleVM>

@{
    ViewBag.Title = "Administrar Planillas";
}

@section Styles{
    <style>
        .admin-planilla-page {
            max-width: 1280px;
            margin: 35px auto;
            padding: 0 10px;
        }

        .admin-planilla-hero {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            border-radius: 18px;
            padding: 28px 30px;
            color: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
            margin-bottom: 25px;
        }

            .admin-planilla-hero h2 {
                margin: 0;
                font-weight: 800;
                font-size: 2rem;
            }

            .admin-planilla-hero p {
                margin: 10px 0 0;
                font-size: 1rem;
                opacity: .95;
            }

        .admin-planilla-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,.05);
        }

        .admin-planilla-card-header {
            background: #f8fbff;
            padding: 18px 22px;
            border-bottom: 1px solid #e9eef5;
        }

            .admin-planilla-card-header h4 {
                margin: 0;
                font-weight: 700;
                color: #1f2d3d;
            }

        .admin-planilla-card-body {
            padding: 20px;
        }

        .table-admin-planillas thead th {
            background: #0f172a;
            color: #fff;
            border: none !important;
            font-size: .90rem;
            text-transform: uppercase;
            letter-spacing: .4px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table-admin-planillas tbody td {
            vertical-align: middle;
            color: #334155;
        }

        .table-admin-planillas tbody tr:hover {
            background-color: #f4fbff;
        }

        .badge-periodo {
            background: rgba(3,169,244,.12);
            color: #0284c7;
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 700;
            display: inline-block;
            white-space: nowrap;
        }

        .badge-empleado {
            background: rgba(0,230,118,.12);
            color: #059669;
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 700;
            display: inline-block;
        }

        .monto-total {
            color: #059669;
            font-weight: 800;
            font-size: 1rem;
            white-space: nowrap;
        }

        .btn-planilla {
            border: none;
            border-radius: 10px;
            padding: 9px 16px;
            font-weight: 700;
            transition: .2s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-detalle {
            background: linear-gradient(90deg, #03a9f4, #00c853);
            color: white;
        }

            .btn-detalle:hover {
                transform: translateY(-1px);
                color: white;
                opacity: .95;
            }

        .empty-box {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
            padding: 35px;
            text-align: center;
            color: #64748b;
        }

            .empty-box i {
                font-size: 3rem;
                color: #03a9f4;
                margin-bottom: 15px;
            }

        .alert-custom {
            border-radius: 14px;
            border: none;
            box-shadow: 0 6px 20px rgba(0,0,0,.06);
        }

        .resumen-top {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .mini-stat {
            background: #fff;
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.05);
        }

            .mini-stat .label {
                display: block;
                font-size: .82rem;
                text-transform: uppercase;
                font-weight: 700;
                color: #64748b;
                margin-bottom: 8px;
            }

            .mini-stat .value {
                display: block;
                font-size: 1.5rem;
                font-weight: 800;
                color: #0f172a;
            }
    </style>
}

@{
    var totalRegistros = Model != null ? Model.Count() : 0;
    var totalPlanillas = Model != null ? Model.Select(x => x.IdPlanilla).Distinct().Count() : 0;
    var totalEmpleados = Model != null ? Model.Select(x => x.IdUsuario).Distinct().Count() : 0;
    var totalPagado = Model != null ? Model.Sum(x => x.TotalPagar) : 0;
}

<div class="admin-planilla-page">
    <div class="admin-planilla-hero">
        <h2><i class="fa-solid fa-users-gear me-2"></i>Planillas de Empleados</h2>
        <p>Consulta todas las planillas registradas de todos los empleados y revisa el detalle individual de cada una.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-custom">
            @TempData["Error"]
        </div>
    }

    <div class="resumen-top">
        <div class="mini-stat">
            <span class="label">Registros mostrados</span>
            <span class="value">@totalRegistros</span>
        </div>
        <div class="mini-stat">
            <span class="label">Planillas distintas</span>
            <span class="value">@totalPlanillas</span>
        </div>
        <div class="mini-stat">
            <span class="label">Empleados</span>
            <span class="value">@totalEmpleados</span>
        </div>
        <div class="mini-stat">
            <span class="label">Total acumulado</span>
            <span class="value">₡ @totalPagado.ToString("N2")</span>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">
            <i class="fa-regular fa-folder-open"></i>
            <h4>No hay planillas registradas</h4>
            <p class="mb-0">Cuando existan planillas calculadas, aparecerán listadas aquí.</p>
        </div>
    }
    else
    {
        <div class="admin-planilla-card">
            <div class="admin-planilla-card-header">
                <h4>Historial general de planillas</h4>
            </div>
            <div class="admin-planilla-card-body">
                <div class="table-responsive">
                    <table class="table table-admin-planillas table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>ID Usuario</th>
                                <th>Período</th>
                                <th>Fecha cálculo</th>
                                <th>Horas normales</th>
                                <th>Horas extra</th>
                                <th>Horas doble</th>
                                <th>Total a pagar</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge-empleado">@item.NombreCompleto</span>
                                    </td>
                                    <td>@item.IdUsuario</td>
                                    <td>
                                        <span class="badge-periodo">
                                            @item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>@item.FechaCalculo.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.HorasNormales</td>
                                    <td>@item.HorasExtra</td>
                                    <td>@item.HorasDoble</td>
                                    <td class="monto-total">₡ @item.TotalPagar.ToString("N2")</td>
                                    <td>
                                        <a href="@Url.Action("DetalleAdmin", "Planilla", new { idPlanilla = item.IdPlanilla, idUsuario = item.IdUsuario })"
                                           class="btn-planilla btn-detalle">
                                            <i class="fa-solid fa-eye me-1"></i> Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
