@model IEnumerable<MiMundoHuellitas.Models.ViewModels.PlanillaDetalleVM>

@{
    ViewBag.Title = "Resultado de Planilla";
}

@section Styles{
    <style>
        .resultado-page {
            max-width: 1250px;
            margin: 35px auto;
            padding: 0 10px;
        }

        .resultado-hero {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            color: white;
            border-radius: 18px;
            padding: 28px 30px;
            margin-bottom: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

            .resultado-hero h2 {
                margin: 0;
                font-weight: 800;
                font-size: 2rem;
            }

            .resultado-hero p {
                margin: 10px 0 0;
                opacity: .95;
            }

        .resultado-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.05);
            overflow: hidden;
        }

        .resultado-card-header {
            background: #f8fbff;
            padding: 20px 24px;
            border-bottom: 1px solid #e9eef5;
        }

            .resultado-card-header h4 {
                margin: 0;
                font-weight: 800;
                color: #0f172a;
            }

        .resultado-card-body {
            padding: 20px;
        }

        .table-resultado thead th {
            background: #0f172a;
            color: white;
            border: none !important;
            vertical-align: middle;
            text-transform: uppercase;
            font-size: .9rem;
        }

        .table-resultado tbody td {
            vertical-align: middle;
            color: #334155;
        }

        .table-resultado tbody tr:hover {
            background-color: #f4fbff;
        }

        .monto-final {
            color: #059669;
            font-weight: 800;
        }

        .periodo-chip {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(0,230,118,.12);
            color: #059669;
            font-weight: 700;
        }

        .alert-custom {
            border-radius: 14px;
            border: none;
            box-shadow: 0 6px 20px rgba(0,0,0,.06);
        }

        .btn-volver {
            background: #0f172a;
            color: #fff;
            border-radius: 10px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 700;
            display: inline-block;
        }

            .btn-volver:hover {
                color: #fff;
                opacity: .95;
            }
    </style>
}

<div class="resultado-page">
    <div class="resultado-hero">
        <h2><i class="fa-solid fa-square-poll-vertical me-2"></i>Resultado del Cálculo</h2>
        <p>Consulta el detalle generado para el período procesado.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning alert-custom">
            No se encontraron datos para el período indicado.
        </div>
    }
    else
    {
        <div class="resultado-card">
            <div class="resultado-card-header">
                <h4>Planillas calculadas</h4>
            </div>
            <div class="resultado-card-body">
                <div class="table-responsive">
                    <table class="table table-resultado table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Colaborador</th>
                                <th>Período</th>
                                <th>Horas normales</th>
                                <th>Horas extra</th>
                                <th>Horas doble</th>
                                <th>Total pagar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.NombreCompleto</strong></td>
                                    <td>
                                        <span class="periodo-chip">
                                            @item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>@item.HorasNormales</td>
                                    <td>@item.HorasExtra</td>
                                    <td>@item.HorasDoble</td>
                                    <td class="monto-final">₡ @item.TotalPagar.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4">
                    <a href="@Url.Action("Calcular", "Planilla")" class="btn-volver">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver a calcular
                    </a>
                </div>
            </div>
        </div>
    }
</div>

