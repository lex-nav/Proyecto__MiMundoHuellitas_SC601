@{
    ViewBag.Title = "Calcular Planilla";
}

@section Styles{
    <style>
        .calc-page {
            max-width: 900px;
            margin: 35px auto;
            padding: 0 10px;
        }

        .calc-hero {
            background: linear-gradient(90deg, #03a9f4, #00e676);
            color: #fff;
            border-radius: 18px;
            padding: 28px 30px;
            margin-bottom: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

            .calc-hero h2 {
                margin: 0;
                font-weight: 800;
                font-size: 2rem;
            }

            .calc-hero p {
                margin: 10px 0 0;
                opacity: .95;
            }

        .calc-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.05);
            overflow: hidden;
        }

        .calc-card-header {
            background: #f8fbff;
            padding: 20px 24px;
            border-bottom: 1px solid #e9eef5;
        }

            .calc-card-header h4 {
                margin: 0;
                font-weight: 800;
                color: #0f172a;
            }

        .calc-card-body {
            padding: 24px;
        }

        .form-label {
            font-weight: 700;
            color: #334155;
            margin-bottom: 8px;
        }

        .form-control {
            border-radius: 12px;
            min-height: 46px;
            border: 1px solid #d9e4ef;
            box-shadow: none;
        }

            .form-control:focus {
                border-color: #03a9f4;
                box-shadow: 0 0 0 0.2rem rgba(3,169,244,.12);
            }

        .btn-calcular {
            background: linear-gradient(90deg, #03a9f4, #00c853);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 22px;
            font-weight: 800;
            font-size: 1rem;
        }

            .btn-calcular:hover {
                opacity: .95;
                color: white;
            }

        .info-note {
            margin-top: 18px;
            padding: 14px 16px;
            background: rgba(3,169,244,.08);
            border-left: 5px solid #03a9f4;
            border-radius: 10px;
            color: #334155;
        }
    </style>
}

<div class="calc-page">
    <div class="calc-hero">
        <h2><i class="fa-solid fa-calculator me-2"></i>Calcular Planilla</h2>
        <p>Selecciona el período a procesar para calcular la planilla correspondiente.</p>
    </div>

    <div class="calc-card">
        <div class="calc-card-header">
            <h4>Formulario de cálculo</h4>
        </div>
        <div class="calc-card-body">
            @using (Html.BeginForm("Calcular", "Planilla", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="fechaInicio" class="form-label">Fecha inicio</label>
                        <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="fechaFin" class="form-label">Fecha fin</label>
                        <input type="date" id="fechaFin" name="fechaFin" class="form-control" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-calcular">
                    <i class="fa-solid fa-gears me-1"></i> Calcular planilla
                </button>
            }

            <div class="info-note">
                <strong>Nota:</strong> asegúrate de que el rango de fechas corresponda al período real de planilla antes de ejecutar el cálculo.
            </div>
        </div>
    </div>
</div>