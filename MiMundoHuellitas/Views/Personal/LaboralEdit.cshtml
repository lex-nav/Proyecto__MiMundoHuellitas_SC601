@model MiMundoHuellitas.Models.ViewModels.EmpleadoLaboralVM

@{
    ViewBag.Title = "Editar Personal";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h2 class="mb-4">Editar Personal</h2>

@using (Html.BeginForm("LaboralEdit", "Personal", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdEmpleadoLaboral)
    @Html.HiddenFor(m => m.IdEmpleadoJornada)
    @Html.HiddenFor(m => m.IdUsuario)
    @Html.HiddenFor(m => m.NombreCompleto)
    @Html.HiddenFor(m => m.Correo)

    <div class="mb-3">
        <label class="form-label">Empleado</label>
        <input type="text" class="form-control" value="@Model.NombreCompleto" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Correo</label>
        <input type="text" class="form-control" value="@Model.Correo" readonly />
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.SalarioHora, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.SalarioHora, new { @class = "form-control", type = "number", step = "0.01" })
        @Html.ValidationMessageFor(m => m.SalarioHora, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.SalarioMensual, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.SalarioMensual, new { @class = "form-control", type = "number", step = "0.01" })
        @Html.ValidationMessageFor(m => m.SalarioMensual, "", new { @class = "text-danger" })
    </div>

    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.Activo, new { @class = "form-check-label" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.IdJornada, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.IdJornada, (SelectList)ViewBag.Jornadas, "-- Seleccione --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.IdJornada, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="@Url.Action("LaboralIndex", "Personal")" class="btn btn-secondary">Cancelar</a>
}