@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteConsumoVM
@using System.Linq

@{
    ViewBag.Title = "Reporte de Consumo - Mi Mundo de Huellitas";
    ViewBag.ActiveMenu = "Reportes";
}

@Html.Partial("_ReportesHeader")

<div class="hero-section d-flex align-items-center text-white"
     style="height: 260px;
            background: linear-gradient(rgba(10,123,72,0.85), rgba(14,118,140,0.85)),
                        url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat;">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Reporte de Consumo</h1>
        <p class="lead mb-0">Analiza servicios más solicitados e ingreso generado</p>
    </div>
</div>

<div class="container my-5">

    <!-- RESUMEN -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold">Total consumido</div>
                    <div class="fs-3 fw-bold" style="color:#0A7B48;">@Model.TotalServiciosConsumidos</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold">Ingreso total</div>
                    <div class="fs-3 fw-bold" style="color:#0E768C;">₡@Model.TotalIngresos.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold">Promedio por servicio</div>
                    <div class="fs-3 fw-bold" style="color:#0A7B48;">₡@Model.PromedioPorServicio.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Consumo", "Reportes", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Desde</label>
                        <input type="date" name="desde"
                               value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Hasta</label>
                        <input type="date" name="hasta"
                               value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Buscar servicio</label>
                        <input type="text" name="texto" value="@Model.Texto" class="form-control" placeholder="Nombre del servicio" />
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-success" style="background:#0A7B48; border:none;">Filtrar</button>
                    </div>
                    <div class="col-md-3 d-grid">
                        <a class="btn btn-outline-secondary" href="@Url.Action("Consumo","Reportes")">Limpiar</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- GRÁFICO -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3" style="color:#0A7B48;">Servicios más consumidos</h5>
            @if (Model.Filas == null || !Model.Filas.Any())
            {
                <div class="text-center text-muted py-4">No hay datos para mostrar el gráfico.</div>
            }
            else
            {
                <canvas id="graficoConsumo" height="90"></canvas>
            }
        </div>
    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Servicio</th>
                        <th>Veces consumido</th>
                        <th>Cantidad total</th>
                        <th>Precio promedio</th>
                        <th>Ingreso total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Filas != null && Model.Filas.Any())
                    {
                        foreach (var f in Model.Filas)
                        {
                            <tr>
                                <td class="fw-bold">@f.IdServicio</td>
                                <td>@f.NombreServicio</td>
                                <td>@f.VecesConsumido</td>
                                <td>@f.CantidadTotal</td>
                                <td>₡@f.PrecioPromedio.ToString("N2")</td>
                                <td class="fw-bold" style="color:#0E768C;">₡@f.IngresoTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay registros para los filtros seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @if (Model.Filas != null && Model.Filas.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const ctx = document.getElementById('graficoConsumo');
                if (ctx) {
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: [@Html.Raw(string.Join(",", Model.Filas.Select(x => "'" + x.NombreServicio.Replace("'", "\\'") + "'")))],
                            datasets: [{
                                label: 'Cantidad total',
                                data: [@string.Join(",", Model.Filas.Select(x => x.CantidadTotal))],
                                backgroundColor: ['#0A7B48', '#0E768C', '#54a0ff', '#f39c12', '#8e44ad', '#2ecc71'],
                                borderRadius: 8
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            });
        </script>
    }
}