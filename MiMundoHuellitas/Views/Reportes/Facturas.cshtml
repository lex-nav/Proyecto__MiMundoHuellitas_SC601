@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteFacturasVM

@{
    ViewBag.Title = "Reporte de ventas";
    ViewBag.ActiveMenu = "Reportes";
}

@section FullWidthTop{
    <div class="hero-section d-flex align-items-center text-white"
         style="height:260px; background: linear-gradient(rgba(10,123,72,.80), rgba(14,118,140,.80)),
                url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat; border-radius:0 0 24px 24px;">
        <div class="container text-center">
            <h1 class="display-5 fw-bold mb-2">Reporte de Ventas</h1>
            <p class="lead mb-0">Facturas emitidas, filtros y exportación</p>
        </div>
    </div>
}

<div class="container my-4">

    <!-- Resumen -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total facturas</div>
                    <div class="fs-3 fw-bold">@Model.TotalFacturas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Monto total</div>
                    <div class="fs-3 fw-bold">@Model.TotalMonto.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Ticket promedio</div>
                    <div class="fs-3 fw-bold">@Model.TicketPromedio.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Facturas", "Reportes", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Desde</label>
                        <input type="date" name="desde"
                               value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Hasta</label>
                        <input type="date" name="hasta"
                               value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        @Html.DropDownListFor(m => m.IdEstado, Model.Estados, new { @class = "form-select" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Método de pago</label>
                        @Html.DropDownListFor(m => m.MetodoPago, Model.MetodosPago, new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Buscar</label>
                        <input type="text" name="texto" value="@(Model.Texto ?? "")"
                               class="form-control" placeholder="Cliente / correo / referencia" />
                    </div>

                    <div class="col-md-2 d-grid">
                        <button class="btn btn-primary">Filtrar</button>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Facturas","Reportes")">Limpiar</a>

                    <a class="btn btn-outline-success"
                       href="@Url.Action("ExportFacturasCsv","Reportes",
                            new { desde = Model.Desde, hasta = Model.Hasta, idEstado = Model.IdEstado, metodoPago = Model.MetodoPago, texto = Model.Texto })">
                        Exportar CSV
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Método pago</th>
                        <th>Referencia</th>
                        <th>Ítems</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Filas == null || !Model.Filas.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No hay resultados con esos filtros.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var f in Model.Filas)
                        {
                            <tr>
                                <td>@f.IdFactura</td>
                                <td>@f.FechaFactura.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="fw-semibold">@f.Cliente</div>
                                    <div class="text-muted small">@f.CorreoCliente</div>
                                </td>
                                <td>@f.Estado</td>
                                <td>@f.MetodoPago</td>
                                <td>@f.NumeroReferencia</td>
                                <td>@f.CantidadItems</td>
                                <td class="fw-bold">@f.MontoTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
