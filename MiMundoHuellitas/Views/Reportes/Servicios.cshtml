
@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteServiciosVM
@{
    ViewBag.Title = "Reporte de Servicios";
    ViewBag.ActiveMenu = "Reportes";
}

@Html.Partial("_ReportesHeader")

@section FullWidthTop{
    <div class="hero-section d-flex align-items-center text-white"
         style="height:260px; background: linear-gradient(rgba(10,123,72,.80), rgba(14,118,140,.80)),
                url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat; border-radius:0 0 24px 24px;">
        <div class="container text-center">
            <h1 class="display-5 fw-bold mb-2">Reporte de Servicios</h1>
            <p class="lead mb-0">Filtra, consulta y exporta el catálogo de servicios</p>
        </div>
    </div>
}

<div class="container my-4">

    <!-- Resumen -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total</div>
                    <div class="fs-3 fw-bold">@Model.Total</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Activos</div>
                    <div class="fs-3 fw-bold">@Model.Activos</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Inactivos</div>
                    <div class="fs-3 fw-bold">@Model.Inactivos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Servicios", "Reportes", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Categoría</label>
                        @Html.DropDownListFor(m => m.Categoria, Model.Categorias, new { @class = "form-select" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select name="soloActivos" class="form-select">
                            <option value="" @(Model.SoloActivos == null ? "selected" : "")>Todos</option>
                            <option value="true" @(Model.SoloActivos == true ? "selected" : "")>Solo activos</option>
                            <option value="false" @(Model.SoloActivos == false ? "selected" : "")>Solo inactivos</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Precio mín</label>
                        <input type="number" step="0.01" name="precioMin" value="@(Model.PrecioMin?.ToString() ?? "")" class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Precio máx</label>
                        <input type="number" step="0.01" name="precioMax" value="@(Model.PrecioMax?.ToString() ?? "")" class="form-control" />
                    </div>

                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary">Filtrar</button>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <a class="btn btn-outline-secondary"
                       href="@Url.Action("Servicios","Reportes")">Limpiar</a>

                    <a class="btn btn-outline-success"
                       href="@Url.Action("ExportServiciosCsv","Reportes", new { categoria = Model.Categoria, soloActivos = Model.SoloActivos, precioMin = Model.PrecioMin, precioMax = Model.PrecioMax })">
                        Exportar CSV
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Servicio</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Duración</th>
                        <th>Activo</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Filas == null || !Model.Filas.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay resultados con esos filtros.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model.Filas)
                        {
                            <tr>
                                <td>@s.IdServicio</td>
                                <td class="fw-semibold">@s.NombreServicio</td>
                                <td>@s.Categoria</td>
                                <td>@s.Precio.ToString("N2")</td>
                                <td>@(s.DuracionMin.HasValue ? (s.DuracionMin + " min") : "-")</td>
                                <td>
                                    @if (s.Activo)
                                    {<span class="badge bg-success">Sí</span> }
                                    else
                                    { <span class="badge bg-secondary">No</span>}
                                </td>
                                <td class="text-muted">@s.Descripcion</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
