
@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteServiciosVM
@{
    ViewBag.Title = "Reporte de Servicios";
    ViewBag.ActiveMenu = "Reportes";
}

@Html.Partial("_ReportesHeader")

<div class="hero-section d-flex align-items-center text-white"
     style="height: 260px;
            background: linear-gradient(rgba(10,123,72,0.85), rgba(14,118,140,0.85)),
                        url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat; border-radius:0 0 24px 24px;">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Reporte de Servicios</h1>
        <p class="lead mb-0">Filtra, consulta y exporta el catálogo de servicios</p>
    </div>
</div>

<div class="container my-5">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Servicios", "Reportes", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Categoría</label>
                        @Html.DropDownList("categoria", Model.Categorias, new { @class = "form-select" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold">Estado</label>
                        <select name="soloActivos" class="form-select">
                            <option value="" @(Model.SoloActivos == null ? "selected" : "")>Todos</option>
                            <option value="true" @(Model.SoloActivos == true ? "selected" : "")>Solo activos</option>
                            <option value="false" @(Model.SoloActivos == false ? "selected" : "")>Solo inactivos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold">Precio mín</label>
                        <input type="number" name="precioMin" value="@Model.PrecioMin" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold">Precio máx</label>
                        <input type="number" name="precioMax" value="@Model.PrecioMax" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button class="btn btn-success w-100" style="background:#0A7B48;border:none;">Filtrar</button>
                        <a class="btn btn-outline-secondary w-100" href="@Url.Action("Servicios","Reportes")">Limpiar</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted">Total Servicios</div>
                    <div class="fs-2 fw-bold" style="color:#0E768C;">@Model.Total</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted text-success">Activos</div>
                    <div class="fs-2 fw-bold" style="color:#0A7B48;">@Model.Activos</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted text-danger">Inactivos</div>
                    <div class="fs-2 fw-bold text-secondary">@Model.Inactivos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3" style="color:#0A7B48;">Precio Promedio por Categoría</h5>
            <canvas id="graficoPrecioServicios" height="80"></canvas>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Servicio</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Duración</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Filas)
                    {
                        <tr>
                            <td>@s.IdServicio</td>
                            <td class="fw-semibold">@s.NombreServicio</td>
                            <td><span class="badge bg-light text-dark border">@s.Categoria</span></td>
                            <td class="fw-bold">@s.Precio.ToString("C")</td>
                            <td>@s.DuracionMin min</td>
                            <td>
                                <span class="badge" style="background:@(s.Activo ? "#0A7B48" : "#8395a7")">
                                    @(s.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @{
            var datosGrafico = Model.Filas.GroupBy(x => x.Categoria)
                .Select(g => new { Cat = g.Key, Prom = g.Average(x => x.Precio) }).ToList();
        }
        const ctx = document.getElementById('graficoPrecioServicios');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", datosGrafico.Select(x => "'" + x.Cat + "'")))],
                datasets: [{
                    label: 'Precio Promedio',
                    data: [@string.Join(",", datosGrafico.Select(x => x.Prom.ToString(System.Globalization.CultureInfo.InvariantCulture)))],
                    backgroundColor: '#0E768C',
                    borderRadius: 5
                }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    </script>
}