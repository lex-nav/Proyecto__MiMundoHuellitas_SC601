@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteMascotasVM

@{
    ViewBag.Title = "Reporte de Mascotas";
    ViewBag.ActiveMenu = "Reportes";
}

@section FullWidthTop{
    <div class="hero-section d-flex align-items-center text-white"
         style="height:260px; background: linear-gradient(rgba(10,123,72,.80), rgba(14,118,140,.80)),
                url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat; border-radius:0 0 24px 24px;">
        <div class="container text-center">
            <h1 class="display-5 fw-bold mb-2">Reporte de Mascotas</h1>
            <p class="lead mb-0">Filtra, consulta y exporta el registro de mascotas</p>
        </div>
    </div>
}

<div class="container my-4">

    <!-- Resumen -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total</div>
                    <div class="fs-3 fw-bold">@Model.Total</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Activas</div>
                    <div class="fs-3 fw-bold">@Model.Activas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Inactivas</div>
                    <div class="fs-3 fw-bold">@Model.Inactivas</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Mascotas", "Reportes", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Especie</label>
                        @Html.DropDownListFor(m => m.IdEspecie, Model.Especies, new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Raza</label>
                        @Html.DropDownListFor(m => m.IdRaza, Model.Razas, new { @class = "form-select" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select name="soloActivas" class="form-select">
                            <option value="" @(Model.SoloActivas == null ? "selected" : "")>Todas</option>
                            <option value="true" @(Model.SoloActivas == true ? "selected" : "")>Solo activas</option>
                            <option value="false" @(Model.SoloActivas == false ? "selected" : "")>Solo inactivas</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Buscar</label>
                        <input type="text" name="texto" value="@(Model.Texto ?? "")" class="form-control" placeholder="Buscar por nombre o correo" />
                    </div>

                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary">Filtrar</button>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Mascotas","Reportes")">Limpiar</a>
                    <a class="btn btn-outline-success" href="@Url.Action("ExportMascotasCsv","Reportes", new { idEspecie = Model.IdEspecie, idRaza = Model.IdRaza, soloActivas = Model.SoloActivas, texto = Model.Texto })">
                        Exportar CSV
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Fecha de Nacimiento</th>
                        <th>Estado</th>
                        <th>Dueño</th>
                        <th>Correo del Dueño</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Filas == null || !Model.Filas.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No hay resultados con esos filtros.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var m in Model.Filas)
                        {
                            <tr>
                                <td>@m.IdMascota</td>
                                <td class="fw-semibold">@m.NombreMascota</td>
                                <td>@m.Especie</td>
                                <td>@m.Raza</td>
                                <td>@(m.FechaNacimiento.HasValue ? m.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "-")</td>
                                <td>
                                    @if (m.Activo)
                                    {<span class="badge bg-success">Activa</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactiva</span>}
                                </td>
                                <td>@m.Dueno</td>
                                <td>@m.CorreoDueno</td>
                                <td class="text-muted">@m.Observaciones</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
