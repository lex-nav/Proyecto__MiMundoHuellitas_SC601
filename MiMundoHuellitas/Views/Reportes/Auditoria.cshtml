@model MiMundoHuellitas.Models.ViewModels.Reportes.ReporteAuditoriaVM

@{
    ViewBag.Title = "Auditoría";
}

<style>
    .card-soft {
        border-radius: 14px;
    }

    .table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f8f9fa;
    }

    .badge-soft {
        background: rgba(0,0,0,.06);
        border: 1px solid rgba(0,0,0,.10);
        font-weight: 600;
        padding: .35rem .55rem;
        border-radius: 999px;
        display: inline-block;
    }

    .mono {
        font-family: Consolas, Menlo, Monaco, "Courier New", monospace;
    }

    .truncate {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .truncate2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .small-muted {
        font-size: .85rem;
        color: #6c757d;
    }
</style>

<div class="container-fluid">

    @* Encabezado de reportes (si lo tienes) *@
    @Html.Partial("_ReportesHeader")

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Auditoría</h3>
            <div class="small-muted">Filtra por fechas, módulo, acción y usuario afectado.</div>
        </div>

        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-success btn-sm" onclick="exportTableToExcel('tblAuditoria', 'Auditoria')">
                Exportar Excel
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="exportTableToCSV('auditoria.csv')">
                Exportar CSV
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm card-soft mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Auditoria", "Reportes", FormMethod.Get, new { @class = "form-row" }))
            {
                <div class="form-group col-12 col-md-2">
                    <label class="mb-1">Desde</label>
                    <input type="date" name="desde"
                           value="@(Model.Desde.HasValue ? Model.Desde.Value.ToString("yyyy-MM-dd") : "")"
                           class="form-control" />
                </div>

                <div class="form-group col-12 col-md-2">
                    <label class="mb-1">Hasta</label>
                    <input type="date" name="hasta"
                           value="@(Model.Hasta.HasValue ? Model.Hasta.Value.ToString("yyyy-MM-dd") : "")"
                           class="form-control" />
                </div>

                <div class="form-group col-12 col-md-2">
                    <label class="mb-1">Módulo</label>
                    <input type="text" name="modulo" value="@Model.Modulo" class="form-control" placeholder="Ej: Usuarios" />
                </div>

                <div class="form-group col-12 col-md-2">
                    <label class="mb-1">Acción</label>
                    <input type="text" name="accion" value="@Model.Accion" class="form-control" placeholder="Ej: Editar" />
                </div>

                <div class="form-group col-12 col-md-3">
                    <label class="mb-1">Usuario afectado</label>
                    @Html.DropDownList("idUsuarioAfectado", Model.Usuarios, new { @class = "form-control" })
                </div>

                <div class="form-group col-12 col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Buscar</button>
                </div>

                <div class="col-12 mt-2 d-flex flex-wrap align-items-center">
                    <a class="btn btn-light btn-sm mr-2" href="@Url.Action("Auditoria","Reportes")">Limpiar</a>

                    <span class="badge-soft mr-2">
                        Resultados: @(Model.Filas?.Count ?? 0)
                    </span>

                    <span class="badge-soft">
                        @(Model.Desde.HasValue || Model.Hasta.HasValue ||
                          !string.IsNullOrWhiteSpace(Model.Modulo) ||
                          !string.IsNullOrWhiteSpace(Model.Accion) ||
                          Model.IdUsuarioAfectado.HasValue
                          ? "Filtros aplicados"
                          : "Sin filtros")
                    </span>
                </div>
            }
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm card-soft">
        <div class="card-body">
            <div class="table-responsive" style="max-height: 70vh;">
                <table class="table table-hover table-sm align-middle" id="tblAuditoria">
                    <thead class="text-uppercase small">
                        <tr>
                            <th style="width:80px;">ID</th>
                            <th style="width:170px;">Fecha</th>
                            <th style="width:220px;">Admin</th>
                            <th style="width:220px;">Afectado</th>
                            <th style="width:140px;">Módulo</th>
                            <th style="width:140px;">Acción</th>
                            <th style="width:160px;">Campo</th>
                            <th>Resumen</th>
                            <th style="width:90px;" class="text-right">Ver</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Filas == null || !Model.Filas.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    No hay registros con los filtros actuales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var r in Model.Filas)
                            {
                                <tr>
                                    <td class="mono">@r.IdAuditoria</td>
                                    <td>
                                        <div class="font-weight-bold">@r.Fecha.ToString("yyyy-MM-dd")</div>
                                        <div class="small-muted mono">@r.Fecha.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td class="truncate">@r.Admin</td>
                                    <td class="truncate">@r.UsuarioAfectado</td>
                                    <td><span class="badge-soft">@r.Modulo</span></td>
                                    <td><span class="badge-soft">@r.Accion</span></td>
                                    <td class="truncate">@r.Campo</td>

                                    <td>
                                        <div class="truncate2">
                                            @if (!string.IsNullOrWhiteSpace(r.Observacion))
                                            {
                                                @r.Observacion
                                            }
                                            else
                                            {
                                                <span class="text-muted">Cambio de valores</span>
                                            }
                                        </div>

                                        <div class="small-muted">
                                            <span class="mono">Antes:</span> @(string.IsNullOrWhiteSpace(r.ValorAnterior) ? "—" : r.ValorAnterior)
                                            <span class="mx-1">→</span>
                                            <span class="mono">Después:</span> @(string.IsNullOrWhiteSpace(r.ValorNuevo) ? "—" : r.ValorNuevo)
                                        </div>
                                    </td>

                                    <td class="text-right">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                data-toggle="modal" data-target="#mdlDetalle"
                                                data-id="@r.IdAuditoria"
                                                data-fecha="@r.Fecha.ToString("yyyy-MM-dd HH:mm:ss")"
                                                data-admin="@Html.AttributeEncode(r.Admin)"
                                                data-usuario="@Html.AttributeEncode(r.UsuarioAfectado)"
                                                data-modulo="@Html.AttributeEncode(r.Modulo)"
                                                data-accion="@Html.AttributeEncode(r.Accion)"
                                                data-campo="@Html.AttributeEncode(r.Campo)"
                                                data-anterior="@Html.AttributeEncode(r.ValorAnterior)"
                                                data-nuevo="@Html.AttributeEncode(r.ValorNuevo)"
                                                data-obs="@Html.AttributeEncode(r.Observacion)">
                                            Ver
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="small-muted mt-2">
                Tip: presiona “Ver” para abrir el detalle completo del cambio.
            </div>
        </div>
    </div>
</div>

<!-- Modal detalle (Bootstrap 4) -->
<div class="modal fade" id="mdlDetalle" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0">Detalle de auditoría</h5>
                    <small class="text-muted" id="dFecha"></small>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>ID</label>
                        <div class="form-control mono" id="dId"></div>
                    </div>
                    <div class="form-group col-md-9">
                        <label>Admin</label>
                        <div class="form-control" id="dAdmin"></div>
                    </div>

                    <div class="form-group col-md-12">
                        <label>Usuario afectado</label>
                        <div class="form-control" id="dUsuario"></div>
                    </div>

                    <div class="form-group col-md-4">
                        <label>Módulo</label>
                        <div class="form-control" id="dModulo"></div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Acción</label>
                        <div class="form-control" id="dAccion"></div>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Campo</label>
                        <div class="form-control" id="dCampo"></div>
                    </div>

                    <div class="form-group col-md-6">
                        <label>Valor anterior</label>
                        <textarea class="form-control mono" id="dAnterior" rows="4" readonly></textarea>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Valor nuevo</label>
                        <textarea class="form-control mono" id="dNuevo" rows="4" readonly></textarea>
                    </div>

                    <div class="form-group col-md-12">
                        <label>Observación</label>
                        <textarea class="form-control" id="dObs" rows="3" readonly></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-light" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
            // Modal: cargar datos (Bootstrap 4 + jQuery)
            $('#mdlDetalle').on('show.bs.modal', function (event) {
                var btn = $(event.relatedTarget);

                $('#dId').text(btn.data('id') || '');
                $('#dFecha').text(btn.data('fecha') || '');

                $('#dAdmin').text(btn.data('admin') || '');
                $('#dUsuario').text(btn.data('usuario') || '');
                $('#dModulo').text(btn.data('modulo') || '');
                $('#dAccion').text(btn.data('accion') || '');
                $('#dCampo').text(btn.data('campo') || '');

                $('#dAnterior').val(btn.data('anterior') || '');
                $('#dNuevo').val(btn.data('nuevo') || '');
                $('#dObs').val(btn.data('obs') || '');
            });

            // Export CSV
            function exportTableToCSV(filename) {
                var rows = document.querySelectorAll("#tblAuditoria tr");
                var csv = [];

                for (var i = 0; i < rows.length; i++) {
                    var cols = rows[i].querySelectorAll("th, td");
                    var row = [];

                    for (var j = 0; j < cols.length; j++) {
                        if (j === cols.length - 1) continue; // quitar columna "Ver"
                        var text = (cols[j].innerText || '').replace(/\s+/g, ' ').trim();
                        text = '"' + text.replace(/"/g, '""') + '"';
                        row.push(text);
                    }
                    csv.push(row.join(","));
                }

                downloadFile(csv.join("\n"), filename, "text/csv;charset=utf-8;");
            }

            // Export Excel (HTML table)
            function exportTableToExcel(tableID, filename) {
                var table = document.getElementById(tableID).cloneNode(true);
                Array.from(table.querySelectorAll("tr")).forEach(function (tr) {
                    if (tr.lastElementChild) tr.lastElementChild.remove();
                });

                var html = table.outerHTML.replace(/ /g, '%20');
                var name = (filename || 'export') + '.xls';

                var a = document.createElement("a");
                a.href = 'data:application/vnd.ms-excel,' + html;
                a.download = name;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }

            function downloadFile(content, filename, mimeType) {
                var blob = new Blob([content], { type: mimeType });
                var url = URL.createObjectURL(blob);
                var a = document.createElement("a");
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }
    </script>
}

