@{
        ViewBag.Title = "Marcaciones";

        var marcacion = ViewBag.Marcacion as MiMundoHuellitas.EF.MH_Marcacion_TB;
        var jornada = ViewBag.Jornada as MiMundoHuellitas.EF.MH_Jornada_TB;

        bool tieneEntrada = marcacion?.HoraEntrada != null;
        bool tieneSalida = marcacion?.HoraSalida != null;

        string fechaHoy = DateTime.Today.ToString("dd/MM/yyyy");
        string horaAhora = DateTime.Now.ToString("HH:mm");
}

<style>
    .page-wrap {
        max-width: 980px;
        margin: 18px auto 40px auto;
    }

    .page-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .page-title h2 {
        margin: 0;
        font-weight: 800;
        letter-spacing: .2px;
    }

    .subtle {
        color: rgba(0,0,0,.6);
        font-size: .95rem;
    }

    .card-soft {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
    }

    .card-header-grad {
        background: linear-gradient(90deg, #03a9f4, #00e676);
        color: #063b2a;
        padding: 14px 18px;
    }

    .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .header-row .badge {
        font-size: .85rem;
        padding: .45rem .7rem;
        border-radius: 999px;
    }

    .kpi {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .kpi .kpi-box {
        background: #fff;
        border: 1px solid rgba(0,0,0,.07);
        border-radius: 14px;
        padding: 12px 14px;
    }

    .kpi .kpi-label {
        font-size: .82rem;
        color: rgba(0,0,0,.55);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .kpi .kpi-value {
        font-size: 1.05rem;
        font-weight: 800;
        margin: 0;
    }

    .timeline {
        border-left: 3px solid rgba(0,0,0,.08);
        margin-left: 8px;
        padding-left: 16px;
        display: grid;
        gap: 10px;
    }

    .t-item {
        position: relative;
        padding: 10px 12px;
        border: 1px solid rgba(0,0,0,.07);
        border-radius: 14px;
        background: #fff;
    }

    .t-item:before {
        content: "";
        position: absolute;
        left: -23px;
        top: 14px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid rgba(0,0,0,.15);
    }

    .t-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 2px;
        font-weight: 800;
    }

    .t-meta {
        color: rgba(0,0,0,.6);
        font-size: .92rem;
        margin: 0;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .btn-pill {
        border-radius: 12px;
        padding: 11px 16px;
        font-weight: 800;
        letter-spacing: .3px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 210px;
        justify-content: center;
    }

    .btn-pill i { font-size: 1.05rem; }

    .note-box {
        background: rgba(3, 169, 244, .08);
        border: 1px dashed rgba(3, 169, 244, .35);
        border-radius: 14px;
        padding: 12px 14px;
        color: rgba(0,0,0,.75);
        font-size: .95rem;
    }

    media (max-width: 768px) {
        .kpi { grid-template-columns: 1fr; }
        .btn-pill { min-width: 100%; }
    }
</style>

<div class="page-wrap">

    <div class="page-title">
        <div>
            <h2>Marcaciones</h2>
            <div class="subtle">Hoy: <strong>@fechaHoy</strong> · Hora actual: <strong>@horaAhora</strong></div>
        </div>

        @* Estado del día *@
        @{
            string estadoText = (!tieneEntrada && !tieneSalida) ? "Pendiente" :
                                (tieneEntrada && !tieneSalida) ? "En jornada" :
                                "Completado";

            string estadoClass = (!tieneEntrada && !tieneSalida) ? "bg-warning text-dark" :
                                 (tieneEntrada && !tieneSalida) ? "bg-primary" :
                                 "bg-success";
        }
        <span class="badge @estadoClass">@estadoText</span>
    </div>

    @* Alerts *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success card-soft" style="border-radius:14px;">
            <strong>Listo:</strong> @TempData["Ok"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger card-soft" style="border-radius:14px;">
            <strong>Atención:</strong> @TempData["Error"]
        </div>
    }


    <div class="card card-soft">
        <div class="card-header card-header-grad">
            <div class="header-row">
                <div style="font-weight:900; font-size:1.05rem;">
                    <i class="fa-solid fa-clock"></i>
                    Control de asistencia
                </div>

                @if (jornada != null)
                {
                    <span class="badge bg-light text-dark">
                        <i class="fa-solid fa-calendar-check"></i>
                        @jornada.Nombre (@jornada.HoraEntrada - @jornada.HoraSalida)
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-dark">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Sin jornada asignada
                    </span>
                }
            </div>
        </div>

        <div class="card-body" style="padding:18px;">
            <div class="kpi">
                <div class="kpi-box">
                    <div class="kpi-label"><i class="fa-solid fa-right-to-bracket"></i> Entrada</div>
                    <p class="kpi-value">
                        @(marcacion?.HoraEntrada?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </p>
                </div>

                <div class="kpi-box">
                    <div class="kpi-label"><i class="fa-solid fa-right-from-bracket"></i> Salida</div>
                    <p class="kpi-value">
                        @(marcacion?.HoraSalida?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </p>
                </div>

                <div class="kpi-box">
                    <div class="kpi-label"><i class="fa-solid fa-note-sticky"></i> Observación</div>
                    <p class="kpi-value" style="font-size:1rem; font-weight:700;">
                        @(string.IsNullOrWhiteSpace(marcacion?.Observacion) ? "—" : marcacion.Observacion)
                    </p>
                </div>
            </div>

            <hr />

            <div class="row g-3">
                <div class="col-md-7">
                    <div style="font-weight:900; margin-bottom:10px;">
                        <i class="fa-solid fa-list-check"></i> Actividad de hoy
                    </div>

                    <div class="timeline">
                        <div class="t-item">
                            <div class="t-title">
                                <span><i class="fa-solid fa-right-to-bracket"></i> Marcación de entrada</span>
                                <span class="badge @(tieneEntrada ? "bg-success" : "bg-secondary")">
                                    @(tieneEntrada ? "Registrada" : "Pendiente")
                                </span>
                            </div>
                            <p class="t-meta">
                                @(tieneEntrada ? marcacion.HoraEntrada.Value.ToString("dd/MM/yyyy HH:mm") : "Aún no has marcado entrada.")
                            </p>
                        </div>

                        <div class="t-item">
                            <div class="t-title">
                                <span><i class="fa-solid fa-right-from-bracket"></i> Marcación de salida</span>
                                <span class="badge @(tieneSalida ? "bg-success" : "bg-secondary")">
                                    @(tieneSalida ? "Registrada" : "Pendiente")
                                </span>
                            </div>
                            <p class="t-meta">
                                @(tieneSalida ? marcacion.HoraSalida.Value.ToString("dd/MM/yyyy HH:mm") : "Aún no has marcado salida.")
                            </p>
                        </div>
                    </div>

                    <div class="actions">
                        @using (Html.BeginForm("MarcarEntrada", "Marcaciones", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success btn-pill" type="submit" @(tieneEntrada ? "disabled" : "")>
                                <i class="fa-solid fa-right-to-bracket"></i>
                                MARCAR ENTRADA
                            </button>
                        }

                        @using (Html.BeginForm("MarcarSalida", "Marcaciones", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-pill" type="submit"
                                    @((!tieneEntrada || tieneSalida) ? "disabled" : "")>
                                <i class="fa-solid fa-right-from-bracket"></i>
                                MARCAR SALIDA
                            </button>
                        }
                    </div>
                </div>

                <div class="col-md-5">
                    <div style="font-weight:900; margin-bottom:10px;">
                        <i class="fa-solid fa-circle-info"></i> Recomendaciones
                    </div>

                    <div class="note-box">
                        <ul style="margin:0; padding-left:18px;">
                            <li>Verifica la hora antes de marcar.</li>
                            <li>Si te equivocas, reporta al administrador.</li>
                            <li>Tu jornada se usa para control interno (tolerancia / puntualidad).</li>
                        </ul>
                    </div>

                    <div style="height:10px;"></div>

                    <div class="note-box" style="background: rgba(0,230,118,.10); border-color: rgba(0,230,118,.35);">
                        <strong><i class="fa-solid fa-shield-heart"></i> Consejo:</strong>
                        Si no tienes jornada asignada, pídele al administrador que te la configure.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
