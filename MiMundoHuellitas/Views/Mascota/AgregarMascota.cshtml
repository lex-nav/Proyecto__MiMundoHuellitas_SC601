@model MiMundoHuellitas.Models.ViewModels.MascotaViewModel

@{
    ViewBag.Title = "Agregar mascota";
    // Layout = "~/Views/Shared/_LayoutInterno.cshtml"; // si aplica
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 80px);">
    <div class="card shadow-sm border-0" style="max-width:720px; width:100%; border-radius:18px;">
        <div class="card-body p-4 p-md-5">

            <div class="d-flex align-items-center gap-3 mb-4">
                <img src="~/StaticFiles/img/Huellitas.png" alt="Mi Mundo Huellitas" style="width:56px; height:auto;" />
                <div class="flex-grow-1">
                    <h3 class="mb-0 fw-bold">Agregar mascota</h3>
                    <div class="text-muted">Registra una nueva mascota para agendar citas 🐾</div>
                </div>
            </div>

            @using (Html.BeginForm("AgregarMascota", "Mascota", FormMethod.Post, new { autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="row g-3">

                    <div class="col-12">
                        @Html.LabelFor(m => m.NombreMascota, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.NombreMascota, new
                        {
                            @class = "form-control form-control-lg",
                            placeholder = "Ej: Luna, Max, Toby…"
                        })
                        @Html.ValidationMessageFor(m => m.NombreMascota, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.IdEspecie, new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.IdEspecie,
                            Model.Especies,
                            "-- Seleccione especie --",
                            new { @class = "form-select form-select-lg" })
                        @Html.ValidationMessageFor(m => m.IdEspecie, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.IdRaza, new { @class = "form-label" })
                        @Html.DropDownListFor(
                            m => m.IdRaza,
                            Model.Razas,
                            "-- Seleccione raza --",
                            new { @class = "form-select form-select-lg" })
                        @Html.ValidationMessageFor(m => m.IdRaza, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.FechaNacimiento, new { @class = "form-label" })
                        @Html.TextBoxFor(
                            m => m.FechaNacimiento,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control form-control-lg",
                                type = "date",
                                max = DateTime.Now.ToString("yyyy-MM-dd")
                            })
                        @Html.ValidationMessageFor(m => m.FechaNacimiento, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Observaciones, new { @class = "form-label" })
                        @Html.TextAreaFor(
                            m => m.Observaciones,
                            new
                            {
                                @class = "form-control",
                                rows = 4,
                                placeholder = "Ej: alergias, comportamiento, medicamentos, cuidados especiales…"
                            })
                        <div class="form-text">Opcional: esto ayuda a brindar un mejor servicio.</div>
                    </div>

                    <div class="col-12 d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-lg" style="border-radius:12px;">
                            Guardar mascota
                        </button>

                        <a href="@Url.Action("VerMascotas", "Mascota")"
                           class="btn btn-outline-secondary btn-lg"
                           style="border-radius:12px;">
                            Cancelar
                        </a>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="p-3 rounded" style="background: rgba(0,0,0,0.03);">
                    <div class="fw-bold mb-1">💡 Tip</div>
                    <div class="text-muted small">
                        Completar especie y raza permite recomendar servicios adecuados y agiliza el agendamiento.
                    </div>
                </div>
            }
        </div>
    </div>
</div>
