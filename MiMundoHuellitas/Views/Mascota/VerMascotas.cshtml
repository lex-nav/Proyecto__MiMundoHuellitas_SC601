@model IEnumerable<MiMundoHuellitas.EF.MH_Mascotas_TB>
@{
    ViewBag.Title = "Mis mascotas";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Mis mascotas</h3>
        @Html.ActionLink("Agregar mascota", "AgregarMascota", "Mascota", null, new { @class = "btn btn-primary" })
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Aún no has registrado mascotas.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Especie</th>
                    <th>Raza</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.NombreMascota</td>
                        <td>@m.MH_Especie_TB.NombreEspecie</td>  <!-- corregido -->
                        <td>@m.MH_Raza_TB.NombreRaza</td>        <!-- corregido -->
                        <td class="text-end">
                            @Html.ActionLink("Editar", "EditarMascota", "Mascota",
                                new { id = m.IdMascota }, new { @class = "btn btn-sm btn-outline-primary" })

                            @using (Html.BeginForm("EliminarMascota", "Mascota", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", m.IdMascota)
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('¿Seguro que deseas eliminar esta mascota?');">
                                    Eliminar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
