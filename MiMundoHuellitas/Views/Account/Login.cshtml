@model MiMundoHuellitas.Models.ViewModels.LoginViewModel

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
    ViewBag.Title = "Iniciar Sesión";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 60px);">
    <div class="card shadow-sm border-0" style="max-width:520px; width:100%; border-radius:18px;">
        <div class="card-body p-4 p-md-5">

            <div class="mb-3">
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-light d-inline-flex align-items-center"
                   style="border-radius:10px; padding:6px 12px; font-size:14px;">

                    <i class="bi bi-arrow-left-short" style="font-size:20px; margin-right:4px;"></i>
                    Home
                </a>
            </div>

            <div class="text-center mb-4">
                <img src="~/StaticFiles/img/Huellitas.png"
                     alt="Mi Mundo Huellitas"
                     style="max-width:120px; height:auto;" />

                <h3 class="mt-3 mb-1 fw-bold">Iniciar sesión</h3>
                <p class="text-muted mb-0">Bienvenido/a de vuelta 🐾</p>
            </div>

            @* Mensajes del controlador (si los usás) *@
            @if (TempData["LoginError"] != null)
            {
                <div class="alert alert-danger">@TempData["LoginError"]</div>
            }
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success">@TempData["Ok"]</div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "mb-2", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Correo, new
                    {
                        @class = "form-control form-control-lg",
                        placeholder = "usuario@correo.com",
                        type = "email",
                        autofocus = "autofocus"
                    })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Contrasena, new
                    {
                        @class = "form-control form-control-lg",
                        placeholder = "********"
                    })
                    @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check m-0">
                        @Html.CheckBoxFor(m => m.Recordarme, new { @class = "form-check-input", id = "Recordarme" })
                        <label class="form-check-label" for="Recordarme">Recordarme</label>
                    </div>

                    <a class="text-decoration-none" href="@Url.Action("RecuperarContrasena","Account")">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" style="border-radius:12px;">
                    Entrar
                </button>
            }

            <hr class="my-4" />

            <div class="text-center">
                <p class="mb-2 text-muted">¿No tienes cuenta?</p>
                <a class="btn btn-outline-primary w-100" style="border-radius:12px;"
                   href="@Url.Action("Register","Account")">
                    Crear cuenta
                </a>
            </div>
        </div>
    </div>
</div>
