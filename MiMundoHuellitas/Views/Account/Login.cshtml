@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
    ViewBag.Title = "Iniciar Sesión";
}

<div class="container" style="max-width:480px; margin-top:40px;">
    <div class="card">
        <div class="card-body">
            <div class="text-center mb-3">
                <img src="~/StaticFiles/img/logo.png" alt="logo" style="max-height:60px;" />
                <h3 class="mt-2">Iniciar Sesión</h3>
            </div>

            @if (TempData["LoginError"] != null)
            {
                <div class="alert alert-danger">@TempData["LoginError"]</div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "formAuthentication", @class = "mb-3" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Correo o Usuario</label>
                    @Html.TextBox("Email", null, new { @class = "form-control", @placeholder = "usuario@correo.com" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    @Html.Password("Password", null, new { @class = "form-control", @placeholder = "••••••••" })
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="remember-me" name="RememberMe" />
                    <label class="form-check-label" for="remember-me">Recordarme</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            }

            <p class="text-center mt-3">
                ¿No tienes cuenta?
                <a href="#">Crear cuenta (pronto)</a>
            </p>
        </div>
    </div>
</div>
