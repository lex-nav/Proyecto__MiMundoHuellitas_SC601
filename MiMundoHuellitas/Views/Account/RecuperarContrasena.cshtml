@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="container" style="max-width:500px; margin-top:40px;">
    <div class="card">
        <div class="card-body">

            <h3 class="text-center mb-3">Recuperar Contraseña</h3>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success">@TempData["Ok"]</div>
            }

            @using (Html.BeginForm("RecuperarContrasena", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input type="email" name="Email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre registrado</label>
                    <input type="text" name="Nombre" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Enviar nueva contraseña</button>
            }

            <p class="text-center mt-3">
                <a href="@Url.Action("Login","Account")">Volver</a>
            </p>

        </div>
    </div>
</div>
