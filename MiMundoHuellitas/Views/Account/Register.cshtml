@model MiMundoHuellitas.Models.ViewModels.RegisterViewModel

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
    ViewBag.Title = "Crear Cuenta";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 60px);">
    <div class="card shadow-sm border-0" style="max-width:540px; width:100%; border-radius:18px;">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <img src="~/StaticFiles/img/Huellitas.png" alt="Mi Mundo Huellitas" style="max-width:120px; height:auto;" />
                <h3 class="mt-3 mb-1 fw-bold">Crear cuenta</h3>
                <p class="text-muted mb-0">Regístrate para agendar servicios y gestionar tus mascotas 🐾</p>
            </div>

            @if (TempData["RegisterError"] != null)
            {
                <div class="alert alert-danger">@TempData["RegisterError"]</div>
            }
            @if (TempData["RegisterOk"] != null)
            {
                <div class="alert alert-success">@TempData["RegisterOk"]</div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "mb-2", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-lg", placeholder = "Nombre completo" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control form-control-lg", placeholder = "usuario@correo.com", type = "email" })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control form-control-lg", placeholder = "88888888", inputmode = "numeric", maxlength = "8" })
                    <div class="form-text">8 dígitos (sin guiones ni espacios).</div>
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control form-control-lg", placeholder = "********" })
                    @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmarContrasena, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmarContrasena, new { @class = "form-control form-control-lg", placeholder = "********" })
                    @Html.ValidationMessageFor(m => m.ConfirmarContrasena, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" style="border-radius:12px;">
                    Crear cuenta
                </button>
            }

            <div class="d-flex justify-content-between align-items-center mt-3">
                <a class="text-decoration-none" href="@Url.Action("Login","Account")">Ya tengo cuenta</a>
                <a class="text-decoration-none" href="@Url.Action("RecuperarContrasena","Account")">¿Olvidaste tu contraseña?</a>
            </div>
        </div>
    </div>
</div>
