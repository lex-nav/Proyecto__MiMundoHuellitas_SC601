@using System.Collections.Generic
@model IEnumerable<dynamic>

@{
    ViewBag.Title = "Catálogo de productos";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo de productos</h2>

   
    @Html.ActionLink("Ver carrito", "Cart", "Carrito", null,
        new { @class = "btn btn-outline-success" })
</div>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-6 mb-4">
          
            <div class="card h-100">
                <div class="row g-0">
                    <div class="col-4">
                        <img class="img-fluid rounded-start" src="@p.ImagenUrl" alt="@p.NombreProducto" />
                    </div>
                    <div class="col-8">
                        <div class="card-body">
                            <h5 class="card-title">@p.NombreProducto</h5>
                            <p class="card-text mb-1">@p.Descripcion</p>
                            <p class="card-text">
                                <small class="text-muted">Categoría: @p.Categoria</small>
                            </p>
                            <p class="fw-bold mb-2">@p.PrecioUnitario.ToString("C")</p>

                            @using (Html.BeginForm("Agregar", "Carrito", FormMethod.Post))
                            {
                                @Html.Hidden("idProducto", (int)p.IdProducto)
                                <div class="input-group">
                                    <input type="number" name="cantidad" value="1" min="1"
                                           class="form-control" />
                                    <button type="submit" class="btn btn-primary">
                                        Agregar al carrito
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@if (totalPages > 1)
{
    <nav aria-label="Paginación de productos">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                @Html.ActionLink("Anterior", "Catalogo", "Carrito",
                    new { page = currentPage - 1 }, new { @class = "page-link" })
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    Página @currentPage de @totalPages
                </span>
            </li>

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                @Html.ActionLink("Siguiente", "Catalogo", "Carrito",
                    new { page = currentPage + 1 }, new { @class = "page-link" })
            </li>
        </ul>
    </nav>
}
