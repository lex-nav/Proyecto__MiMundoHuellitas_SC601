@model List<MiMundoHuellitas.Models.CarritoItemViewModel>

@{
    ViewBag.Title = "Carrito de compras";
    var total = (Model == null) ? 0 : Model.Sum(i => i.Subtotal);
}

@section FullWidthTop {
    <!-- HERO -->
    <div class="hero-carrito">
        <div class="hero-overlay"></div>

        <div class="container hero-content">
            <h1 class="hero-title">Carrito de compras</h1>
            <p class="hero-subtitle">Revisá tus productos antes de continuar</p>
        </div>
    </div>

    <style>
        .hero-carrito {
            position: relative;
            border-radius: 0 0 22px 22px;
            overflow: hidden;
            min-height: 220px;
            margin: 0 0 22px 0;
            background: linear-gradient(90deg, rgba(3,169,244,0.75), rgba(0,230,118,0.75)), url('/StaticFiles/img/slider-bg.jpg') center/cover no-repeat;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.15);
        }

        .hero-content {
            position: relative;
            padding: 60px 12px;
            text-align: center;
            color: #0b0f14;
        }

        .hero-title {
            font-weight: 800;
            font-size: clamp(28px, 4vw, 46px);
            margin: 0;
        }

        .hero-subtitle {
            margin-top: 8px;
            font-weight: 600;
            color: rgba(11,15,20,0.82);
        }

        .card-soft {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 18px;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        }

        .table thead th {
            font-size: 12px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6b7280;
            background: #f8fafc !important;
        }

        .btn-round {
            border-radius: 12px;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
        }

        .qty-input {
            max-width: 110px;
        }

        .total-box {
            background: rgba(0,200,83,0.08);
            border: 1px solid rgba(0,200,83,0.16);
            border-radius: 16px;
            padding: 16px 18px;
        }
    </style>
}

<div class="container my-4">

    <!-- Panel Header -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-3">
        <div>
            <h3 class="fw-bold mb-1">Tu carrito</h3>
            <p class="text-muted mb-0">Podés actualizar cantidades o eliminar productos.</p>
        </div>

        <div class="mt-2 mt-md-0">
            <span class="badge rounded-pill bg-light text-secondary px-3 py-2">
                @(Model == null ? 0 : Model.Count) ítems
            </span>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card card-soft border-0">
            <div class="card-body p-4 p-md-5 text-center">
                <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3"></i>
                <h4 class="fw-bold mb-2">Tu carrito está vacío</h4>
                <p class="text-muted mb-4">Explorá productos y agregá lo que necesitás para tu mascota 🐾</p>

                <a href="@Url.Action("Productos","Home")" class="btn btn-success btn-round px-4">
                    <i class="fa-solid fa-bag-shopping me-2"></i> Ver productos
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card card-soft border-0 mb-3">
            <div class="card-body p-3 p-md-4">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width:240px;">Cantidad</th>
                                <th>Precio</th>
                                <th>Subtotal</th>
                                <th class="text-center" style="width:90px;">Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NombreProducto</td>

                                    <td>
                                        @using (Html.BeginForm("ActualizarCantidad", "Carrito", FormMethod.Post, new { @class = "d-flex align-items-center gap-2" }))
                                        {
                                            @Html.Hidden("idProducto", item.IdProducto)

                                            <input type="number"
                                                   name="cantidad"
                                                   value="@item.Cantidad"
                                                   min="1"
                                                   class="form-control qty-input"
                                                   aria-label="Cantidad" />

                                            <button type="submit" class="btn btn-outline-secondary btn-round px-3">
                                                <i class="fa-solid fa-rotate me-2"></i> Actualizar
                                            </button>
                                        }
                                    </td>

                                    <td class="text-muted">@item.PrecioUnitario.ToString("C")</td>
                                    <td class="fw-semibold">@item.Subtotal.ToString("C")</td>

                                    <td class="text-center">
                                        @using (Html.BeginForm("Eliminar", "Carrito", FormMethod.Post))
                                        {
                                            @Html.Hidden("idProducto", item.IdProducto)

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-icon"
                                                    title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="d-flex flex-column flex-md-row gap-3 align-items-stretch align-items-md-center justify-content-between">

            <div class="total-box">
                <div class="text-muted small">Total</div>
                <div class="fs-4 fw-bold mb-0">@total.ToString("C")</div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a href="@Url.Action("Productos","Home")" class="btn btn-outline-secondary btn-round px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i> Seguir comprando
                </a>

                @Html.ActionLink(
                    "Continuar con la compra",
                    "Checkout",
                    "Carrito",
                    null,
                    new { @class = "btn btn-success btn-round px-4" }
                )
            </div>
        </div>
    }
</div>
