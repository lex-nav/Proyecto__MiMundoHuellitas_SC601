@model MiMundoHuellitas.Models.CheckoutViewModel

@{
    ViewBag.Title = "Confirmar compra";
    var items = Model?.Items ?? new List<MiMundoHuellitas.Models.CarritoItemViewModel>();
}

@section FullWidthTop {
    <!-- HERO -->
    <div class="hero-checkout">
        <div class="hero-overlay"></div>

        <div class="container hero-content">
            <h1 class="hero-title">Confirmar compra</h1>
            <p class="hero-subtitle">Completá tus datos y revisá el resumen antes de finalizar</p>
        </div>
    </div>

    <style>
        .hero-checkout {
            position: relative;
            border-radius: 0 0 22px 22px;
            overflow: hidden;
            min-height: 220px;
            margin: 0 0 22px 0;
            background: linear-gradient(90deg, rgba(3,169,244,0.75), rgba(0,230,118,0.75)), url('/StaticFiles/img/slider-bg.jpg') center/cover no-repeat;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.15);
        }

        .hero-content {
            position: relative;
            padding: 60px 12px;
            text-align: center;
            color: #0b0f14;
        }

        .hero-title {
            font-weight: 800;
            font-size: clamp(28px, 4vw, 46px);
            margin: 0;
        }

        .hero-subtitle {
            margin-top: 8px;
            font-weight: 600;
            color: rgba(11,15,20,0.82);
        }

        .card-soft {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 18px;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        }

        .table thead th {
            font-size: 12px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6b7280;
            background: #f8fafc !important;
        }

        .btn-round {
            border-radius: 12px;
        }

        .total-box {
            background: rgba(0,200,83,0.08);
            border: 1px solid rgba(0,200,83,0.16);
            border-radius: 16px;
            padding: 16px 18px;
        }

        .section-title {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .section-sub {
            color: #6b7280;
            margin-bottom: 0;
        }

        .form-label {
            font-weight: 600;
        }

        .paypal-section {
            background: #fff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 16px;
            padding: 18px;
        }

        #paypal-button-container {
            max-width: 420px;
        }
    </style>
}

<div class="container my-4">

    @using (Html.BeginForm("Checkout", "Carrito", FormMethod.Post, new { id = "checkoutForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-3">

            <!-- Datos de pago -->
            <div class="col-lg-5">
                <div class="card card-soft border-0 h-100">
                    <div class="card-body p-4">

                        <div class="mb-3">
                            <div class="section-title">
                                <i class="fa-solid fa-credit-card me-2 text-primary"></i>
                                Datos de compra
                            </div>
                            <p class="section-sub">Ingresá los datos requeridos para confirmar el pago.</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            @Html.TextBoxFor(m => m.CorreoCliente, new
                            {
                                @class = "form-control",
                                type = "email",
                                placeholder = "usuario@correo.com"
                            })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Método de pago</label>
                            @Html.TextBoxFor(m => m.MetodoPago, new
                            {
                                @class = "form-control",
                                placeholder = "SINPE / Transferencia / Tarjeta / PayPal",
                                id = "MetodoPago"
                            })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Número de referencia</label>
                            @Html.TextBoxFor(m => m.NumeroReferencia, new
                            {
                                @class = "form-control",
                                placeholder = "Ej: 12345678"
                            })
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Observaciones</label>
                            @Html.TextAreaFor(m => m.Observaciones, new
                            {
                                @class = "form-control",
                                rows = 3,
                                placeholder = "Notas adicionales (opcional)"
                            })
                        </div>

                    </div>
                </div>
            </div>

            <!-- Resumen -->
            <div class="col-lg-7">
                <div class="card card-soft border-0">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <div class="section-title">
                                    <i class="fa-solid fa-receipt me-2 text-success"></i>
                                    Resumen del pedido
                                </div>
                                <p class="section-sub">Verificá productos, cantidades y subtotales.</p>
                            </div>

                            <span class="badge rounded-pill bg-light text-secondary px-3 py-2">
                                @items.Count ítems
                            </span>
                        </div>

                        <div class="table-responsive mt-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th style="width:90px;">Cant.</th>
                                        <th style="width:140px;">Precio</th>
                                        <th style="width:140px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in items)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.NombreProducto</td>
                                            <td class="text-muted">@item.Cantidad</td>
                                            <td class="text-muted">@item.PrecioUnitario.ToString("C")</td>
                                            <td class="fw-semibold">@item.Subtotal.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mt-4">
                            <div class="total-box">
                                <div class="text-muted small">Total</div>
                                <div class="fs-4 fw-bold mb-0">@Model.MontoTotal.ToString("C")</div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <a href="@Url.Action("Carrito","Carrito")" class="btn btn-outline-secondary btn-round px-4">
                                    <i class="fa-solid fa-arrow-left me-2"></i> Volver al carrito
                                </a>

                                <button type="submit" class="btn btn-success btn-round px-4">
                                    <i class="fa-solid fa-check me-2"></i> Finalizar compra
                                </button>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="paypal-section">
                            <div class="section-title mb-2">
                                <i class="fa-brands fa-paypal me-2 text-primary"></i>
                                Pagar con PayPal
                            </div>
                            <p class="section-sub mb-3">También podés completar tu compra usando PayPal.</p>

                            <div id="paypal-button-container"></div>
                            <div id="paypal-result" class="mt-3"></div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }

</div>

<script src="https://www.paypal.com/sdk/js?client-id=@System.Configuration.ConfigurationManager.AppSettings["PayPalClientId"]&currency=USD"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof paypal === "undefined") {
            console.error("No se cargó el SDK de PayPal.");
            return;
        }

        paypal.Buttons({
            createOrder: function () {
                return fetch('@Url.Action("CreateOrder", "PayPal")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    if (!data.success) {
                        throw new Error(data.message || 'No se pudo crear la orden de PayPal.');
                    }

                    return data.id;
                });
            },

            onApprove: function (data) {
                return fetch('@Url.Action("CaptureOrder", "PayPal")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: 'orderID=' + encodeURIComponent(data.orderID)
                })
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    var resultBox = document.getElementById('paypal-result');
                    var metodoPagoInput = document.getElementById('MetodoPago');

                    if (data.success) {
                        if (metodoPagoInput) {
                            metodoPagoInput.value = 'PayPal';
                        }

                        resultBox.innerHTML =
                            '<div class="alert alert-success">' +
                                'Pago realizado correctamente con PayPal. Orden: ' + data.paypalOrderId +
                            '</div>';

                        // Si luego quieres enviar automáticamente el formulario:
                        // document.getElementById("checkoutForm").submit();
                    } else {
                        resultBox.innerHTML =
                            '<div class="alert alert-danger">' +
                                'Error al capturar el pago: ' + (data.message || '') +
                            '</div>';
                    }
                })
                .catch(function (error) {
                    document.getElementById('paypal-result').innerHTML =
                        '<div class="alert alert-danger">' +
                            'Ocurrió un error al procesar el pago con PayPal.' +
                        '</div>';

                    console.error(error);
                });
            },

            onCancel: function () {
                document.getElementById('paypal-result').innerHTML =
                    '<div class="alert alert-warning">El usuario canceló el pago con PayPal.</div>';
            },

            onError: function (err) {
                document.getElementById('paypal-result').innerHTML =
                    '<div class="alert alert-danger">Ocurrió un error con PayPal.</div>';

                console.error(err);
            }
        }).render('#paypal-button-container');
    });
</script>