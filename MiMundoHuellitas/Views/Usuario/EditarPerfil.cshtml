@model MiMundoHuellitas.Models.ViewModels.PerfilViewModel
@{
    ViewBag.Title = "Editar perfil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Editar perfil</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("EditarPerfil", "Usuario", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Telefono, new { @class = "form-label" })
                            @Html.TextBoxFor(
                                m => m.Telefono,
                                new { @class = "form-control", placeholder = "+506 0000-0000" }
                            )
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
                        </div>

                        <!-- NUEVO: Dirección -->
                        <div class="mb-3">
                            @Html.Label("Dirección", new { @class = "form-label" })
                            @Html.TextAreaFor(
                                m => m.DireccionDetalle,
                                3,
                                40,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Ej: Residencial X, casa 10, San José, Costa Rica"
                                }
                            )
                            @Html.ValidationMessageFor(m => m.DireccionDetalle, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CodigoPostal, new { @class = "form-label" })
                            @Html.TextBoxFor(
                                m => m.CodigoPostal,
                                new { @class = "form-control", placeholder = "Ej: 10101" }
                            )
                            @Html.ValidationMessageFor(m => m.CodigoPostal, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            Guardar cambios
                        </button>

                        <a href="@Url.Action("Perfil", "Usuario")" class="btn btn-secondary w-100">
                            Cancelar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
