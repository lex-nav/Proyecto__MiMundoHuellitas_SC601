@model MiMundoHuellitas.Models.ViewModels.Comisiones.ComisionFormVM

@{
    ViewBag.Title = "Nueva Comisión";
}

<h2>Nueva Comisión</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(m => m.IdUsuario)
        @Html.DropDownListFor(
            m => m.IdUsuario,
            Model.Usuarios,
            "-- Seleccione --",
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.TipoComision)
        @Html.TextBoxFor(m => m.TipoComision, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Porcentaje)
        @Html.TextBoxFor(m => m.Porcentaje, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.MontoFijo)
        @Html.TextBoxFor(m => m.MontoFijo, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.FechaInicio)
        @Html.TextBoxFor(
            m => m.FechaInicio,
            "{0:yyyy-MM-dd}",
            new { type = "date", @class = "form-control" }
        )
    </div>

    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
        <label class="form-check-label">Activo</label>
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a href="@Url.Action("Index")" class="btn btn-secondary">
        Cancelar
    </a>
}