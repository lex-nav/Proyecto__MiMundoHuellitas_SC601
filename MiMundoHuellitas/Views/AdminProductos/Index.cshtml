@model IEnumerable<MiMundoHuellitas.EF.MH_Productos_TB>

@{
    ViewBag.Title = "Admin Productos";
}

@section FullWidthTop {
    <!-- HERO -->
    <div class="hero-adminproductos">
        <div class="hero-overlay"></div>

        <div class="container hero-content">
            <h1 class="hero-title">Administrar productos</h1>
            <p class="hero-subtitle">Gestión de inventario y catálogo del sistema</p>
        </div>
    </div>

    @if (ViewBag.CantidadBajos > 0)
    {
        <div class="alert alert-danger d-flex align-items-center shadow-sm" style="border-radius:12px;">
            <span style="font-size:20px;" class="me-2">⚠️</span>
            <div>
                Hay <strong>@ViewBag.CantidadBajos</strong> productos con stock bajo.
            </div>
        </div>
    }
    <style>
        /* HERO */
        .hero-adminproductos {
            position: relative;
            border-radius: 0 0 22px 22px;
            overflow: hidden;
            min-height: 240px;
            margin: 0 0 22px 0;
            background: linear-gradient(90deg, rgba(0,200,83,0.75), rgba(3,169,244,0.75)), url('/StaticFiles/img/slider-bg.jpg') center/cover no-repeat;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.15);
        }

        .hero-content {
            position: relative;
            padding: 70px 12px;
            text-align: center;
            color: #0b0f14;
        }

        .hero-title {
            font-weight: 800;
            letter-spacing: 0.4px;
            font-size: clamp(32px, 4vw, 52px);
            margin: 0;
        }

        .hero-subtitle {
            margin: 10px 0 0;
            font-weight: 600;
            color: rgba(11,15,20,0.82);
            font-size: 16px;
        }

        /* PANEL */
        .panel-title {
            font-size: 28px;
            font-weight: 800;
            color: #0b3d2e;
            margin-bottom: 6px;
        }

        .panel-subtitle {
            color: #6b7280;
            margin-bottom: 18px;
        }

        .card-soft {
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 18px;
            box-shadow: 0 8px 18px rgba(0,0,0,0.04);
        }

        .table thead th {
            font-size: 12px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6b7280;
            background: #f8fafc !important;
        }

        .btn-round {
            border-radius: 12px;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
        }

        .badge-soft {
            background: rgba(0,200,83,0.12);
            color: #0b6b3a;
            border: 1px solid rgba(0,200,83,0.18);
        }
    </style>
}

<div class="container my-4">

    <!-- Header del panel -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-3">
        <div>
            <div class="panel-title">Panel de productos</div>
            <div class="panel-subtitle">
                Administrá productos, precios y stock disponible.
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="badge badge-soft rounded-pill px-3 py-2">
                @((Model == null) ? 0 : Model.Count()) productos
            </span>

            @* Si tenés Create, descomentá:
                <a href="@Url.Action("Create","AdminProductos")" class="btn btn-success btn-round px-3">
                    <i class="fa-solid fa-box-open me-2"></i> Nuevo producto
                </a>
            *@
        </div>
    </div>

    <!-- Card tabla -->
    <div class="card card-soft border-0">
        <div class="card-body p-3 p-md-4">
            @if (ViewBag.ProductosBajos != null && ViewBag.ProductosBajos.Count > 0)
            {
                <div class="mb-4">
                    <h4 class="fw-bold mb-3">⚠️ Productos con stock bajo</h4>

                    <div class="row g-4">
                        @foreach (var p in ViewBag.ProductosBajos)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0"
                                     style="border-radius:18px;">
                                    <img src="@p.ImagenUrl" class="img-fluid mb-3" style="border-radius:12px;" />
                                    <div class="card-body p-4">

                                        <!-- NOMBRE -->
                                        <h5 class="fw-bold mb-2">
                                            @p.NombreProducto
                                        </h5>

                                        <!-- CATEGORIA -->
                                        <div class="text-muted small mb-2">
                                            📦 @p.Categoria
                                        </div>

                                        <!-- PRECIO -->
                                        <div class="mb-2">
                                            💲 ₡@p.PrecioUnitario
                                        </div>

                                        <!-- STOCK -->
                                        <div class="mb-3">
                                            @if (p.StockActual == 0)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                                    Sin stock
                                                </span>
                                            }
                                            else if (p.StockActual <= 5)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                                    Bajo (@p.StockActual)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                    @p.StockActual
                                                </span>
                                            }
                                        </div>

                                        <!-- BOTÓN -->
                                        <a href="@Url.Action("Edit", "AdminProductos", new { id = p.IdProducto })"
                                           class="btn btn-outline-primary w-100"
                                           style="border-radius:12px;">
                                            Reabastecer / Editar
                                        </a>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-light border rounded-3 text-center py-4 mb-0">
                    <i class="fa-solid fa-box-open fa-2x text-muted mb-2"></i>
                    <div class="fw-semibold text-muted">
                        No hay productos registrados
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Descripción</th>
                                <th>Categoría</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th class="text-center" style="width:160px;">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @p.NombreProducto
                                    </td>

                                    <td class="text-muted">
                                        @p.Descripcion
                                    </td>

                                    <td>
                                        @p.Categoria
                                    </td>

                                    <td class="fw-semibold">
                                        ₡@p.PrecioUnitario.ToString("N2")
                                    </td>

                                    <td>
                                        @if (p.StockActual > 0)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                @p.StockActual
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                                Sin stock
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a href="@Url.Action("Edit","AdminProductos", new { id = p.IdProducto })"
                                           class="btn btn-outline-primary btn-icon me-1"
                                           title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <a href="@Url.Action("Delete","AdminProductos", new { id = p.IdProducto })"
                                           class="btn btn-outline-danger btn-icon"
                                           title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>

