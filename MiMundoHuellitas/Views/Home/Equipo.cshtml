@model dynamic
@{

    ViewBag.Title = "Nuestro Equipo - Mi Mundo de Huellitas";
}

<style>
    /* Colores base */
    .text-contact-primary {
        color: #0A7B48 !important; /* Verde */
    }

    .text-contact-secondary {
        color: #0E768C !important; /* Azul */
    }


    .team-card {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #dee2e6;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(14, 118, 140, 0.15) !important;
        }

    .team-header-img {
        padding: 20px 0; /* Espacio vertical arriba y abajo de la foto */
        background-color: rgba(14, 118, 140, 0.10); /* Un 5% de opacidad de tu azul, para que sea muy sutil */
        border-bottom: 1px solid #dee2e6;
        height: 190px; /* Altura fija para el área de la imagen */
    }

    .team-img-circle {
        width: 120px; /* Tamaño de la imagen */
        height: 120px;
        object-fit: cover; /* Asegura que la imagen no se distorsione */
        border-radius: 50%; /* Hace la imagen redonda */
        border: 4px solid #0E768C; /* Borde de color secundario para destacar */
        display: block;
        margin: 0 auto;
    }


    .commitment-block {
        background: linear-gradient(135deg, #0A7B48 0%, #0E768C 100%); /* Degradado de Verde a Azul */
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(14, 118, 140, 0.4);
    }

        .commitment-block h3 {
            font-weight: 700;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        }

    /* --- Estilos de Insignias y Footer --- */

    .team-badge {
        font-size: 0.75rem;
        font-weight: 500;
        margin: 2px;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .bg-primary-custom {
        background-color: #0A7B48; /* Verde */
        color: white;
    }

    .bg-secondary-custom {
        background-color: #0E768C; /* Azul */
        color: white;
    }

    .card-footer {
        background-color: #f1f1f1;
        border-top: 1px solid #e9ecef;
    }
</style>

<div class="hero-section d-flex align-items-center text-white"
     style="height: 260px;
            background: linear-gradient(rgba(10,123,72,0.75), rgba(14,118,140,0.75));">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Conoce a Nuestros Estilistas y Staff</h1>
        <p class="lead">El corazón de Mi Mundo de Huellitas: pasión, experiencia y dedicación.</p>
    </div>
</div>

<div class="container my-5">

    <section id="introduccion" class="text-center mb-5">
        <h2 class="text-contact-primary mb-3">Personas que Cuidan de tu Mascota</h2>
        <p class="fs-5 text-muted">
            Nuestro equipo multidisciplinario asegura que cada visita sea segura, profesional y muy divertida.
        </p>
    </section>

    <div class="row g-4 justify-content-center mb-5">

        <div class="col-md-6 col-lg-4">
            <div class="team-card shadow-sm h-100">
                <div class="team-header-img">
                    <img src="~/StaticFiles/img/Noemy.jpg"
                         class="team-img-circle shadow-sm" />
                    <p class="text-contact-secondary fw-bold mt-2 mb-0">Noemy Bernal</p>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title text-contact-secondary">Administrador</h5>
                    <p class="card-text small text-muted">
                        Encargada de la gestión de citas, la logística de productos y la calidad del servicio al cliente.
                    </p>
                    <div class="mt-3">
                        <span class="badge team-badge bg-primary-custom">Gestión Operativa</span>
                        <span class="badge team-badge bg-secondary-custom">Atención al Cliente</span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="#" class="text-contact-secondary me-2"><i class="fas fa-envelope"></i></a>
                    <a href="#" class="text-contact-secondary"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="team-card shadow-sm h-100">
                <div class="team-header-img">
                    <img src="~/StaticFiles/img/Melany.jpg"
                         class="team-img-circle shadow-sm" />
                    <p class="text-contact-primary fw-bold mt-2 mb-0">Melany Fernández.</p>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title text-contact-secondary">Groomer Profesional</h5>
                    <p class="card-text small text-muted">
                        Experta en técnicas de corte, stripping y manejo de pieles sensibles. Especialidad en razas grandes.
                    </p>
                    <div class="mt-3">
                        <span class="badge team-badge bg-primary-custom">Estética Canina</span>
                        <span class="badge team-badge bg-secondary-custom">Salud del Pelaje</span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="#" class="text-contact-secondary me-2"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" class="text-contact-secondary"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="team-card shadow-sm h-100">
                <div class="team-header-img">
                    <img src="~/StaticFiles/img/asistente.jpg"
                         class="team-img-circle shadow-sm" />
                    <p class="text-contact-secondary fw-bold mt-2 mb-0">Alisson Oviedo.</p>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title text-contact-secondary">Asistente Canino</h5>
                    <p class="card-text small text-muted">
                        Encargada del manejo positivo, el secado inicial, juegos y tranquilidad de la mascota durante la espera.
                    </p>
                    <div class="mt-3">
                        <span class="badge team-badge bg-primary-custom">Manejo Básico</span>
                        <span class="badge team-badge bg-secondary-custom">Cuidados Post-Baño</span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="#" class="text-contact-secondary me-2"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" class="text-contact-secondary"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>

    <h3 class="text-center text-contact-primary mb-4">✨ Soporte y Ambiente</h3>

    <div class="row g-4 justify-content-center">

        <div class="col-md-6 col-lg-4">
            <div class="team-card shadow-sm h-100">
                <div class="team-header-img">
                    <img src="~/StaticFiles/img/Ashley.jpg"
                         class="team-img-circle shadow-sm" />
                    <p class="text-contact-primary fw-bold mt-2 mb-0">Asley Castillo.</p>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title text-contact-secondary">Asistente de Limpieza</h5>
                    <p class="card-text small text-muted">
                        Responsable de mantener el área de trabajo y recepción impecable, garantizando la desinfección total.
                    </p>
                    <div class="mt-3">
                        <span class="badge team-badge bg-primary-custom">Sanitización</span>
                        <span class="badge team-badge bg-secondary-custom">Mantenimiento</span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <small class="text-muted">Parte de nuestro staff esencial.</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="team-card shadow-sm h-100">
                <div class="team-header-img">
                    <img src="~/StaticFiles/img/Mariana.jpg"
                         class="team-img-circle shadow-sm" />
                    <p class="text-contact-secondary fw-bold mt-2 mb-0">Mariana Lara.</p>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title text-contact-secondary">Asistente de Limpieza</h5>
                    <p class="card-text small text-muted">
                        Asegura que todos los equipos y herramientas de grooming estén esterilizados y listos para el siguiente cliente.
                    </p>
                    <div class="mt-3">
                        <span class="badge team-badge bg-primary-custom">Control de Higiene</span>
                        <span class="badge team-badge bg-secondary-custom">Soporte Logístico</span>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <small class="text-muted">Parte de nuestro staff esencial.</small>
                </div>
            </div>
        </div>
    </div>

    <section id="compromiso" class="commitment-block text-center mt-5 p-5 shadow-lg">
        <h3 class="text-white mb-3"><i class="fas fa-paw me-2"></i> Un Compromiso con el Corazón</h3>
        <p class="lead text-white mb-0">
            Somos un equipo unido por el amor a las mascotas. Juntos, garantizamos el mejor servicio, la máxima higiene y un ambiente libre de estrés.
        </p>
    </section>

</div>