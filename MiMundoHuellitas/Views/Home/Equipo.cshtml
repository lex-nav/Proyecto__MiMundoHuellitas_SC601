@{

    ViewData["Title"] = "Nuestro Equipo de Profesionales";
}

<div class="hero-section d-flex align-items-center text-white"
     style="height: 260px; background: linear-gradient(rgba(10,123,72,0.80), rgba(14,118,140,0.80)),
           url('/StaticFiles/img/Fondo_Huellitas.jpg') center/cover no-repeat;">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Conoce a Nuestro Equipo</h1>
        <p class="lead mb-0">
            Profesionales dedicados, apasionados por el bienestar de tus mascotas.
        </p>
    </div>
</div>

<section class="team-section py-5">
    <div class="container">

        <header class="text-center mb-5">
            <h2 class="display-4 fw-bold team-title-color">Nuestros Pilares</h2>
            <p class="lead text-muted">
                Dedicación, profesionalismo y amor por los animales en cada servicio.
            </p>
        </header>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-4">

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="administrador">
                    <div class="card-body text-center p-4">
                        <img src="/StaticFiles/img/noemy.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de Juan Pérez">
                        <h5 class="card-title fw-bold">Noemy Bernal</h5>
                        <p class="card-text text-uppercase small team-role-color">Administrador</p>
                        <p class="card-text description text-muted">
                            Líder visionario a cargo de la gestión general y la calidad del servicio.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="groomer">
                    <div class="card-body text-center p-4">
                        <img src="/StaticFiles/img/mela.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de María López">
                        <h5 class="card-title fw-bold">Melany Fernández</h5>
                        <p class="card-text text-uppercase small team-role-color">Groomer Profesional</p>
                        <p class="card-text description text-muted">
                            Experta en estilismo canino y felino, garantiza cortes y peinados perfectos.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="banista">
                    <div class="card-body text-center p-4">
                        <img src="~/StaticFiles/img/person_2.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de Carlos Gómez">
                        <h5 class="card-title fw-bold">Carlos Gómez</h5>
                        <p class="card-text text-uppercase small team-role-color">Bañista Profesional</p>
                        <p class="card-text description text-muted">
                            Se encarga del bienestar e higiene, asegurando baños relajantes y profundos.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="veterinario">
                    <div class="card-body text-center p-4">
                        <img src="/StaticFiles/img/ali.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de Laura Torres">
                        <h5 class="card-title fw-bold">Allison Oviedo</h5>
                        <p class="card-text text-uppercase small team-role-color">Asistente Veterinario</p>
                        <p class="card-text description text-muted">
                            Brinda apoyo médico, garantizando la seguridad y salud de nuestras mascotas.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="aseo-1">
                    <div class="card-body text-center p-4">
                        <img src="/StaticFiles/img/chabu.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de Roberto Díaz">
                        <h5 class="card-title fw-bold">Mariana Lara</h5>
                        <p class="card-text text-uppercase small team-role-color">Asistente de Aseo</p>
                        <p class="card-text description text-muted">
                            Mantiene nuestras instalaciones impecables y seguras para todos.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card team-card shadow-sm h-100 border-0 rounded-3" data-role="aseo-2">
                    <div class="card-body text-center p-4">
                        <img src="/StaticFiles/img/achi.jpg" class="team-member-img rounded-circle mb-3" alt="Imagen de Sofía Castro">
                        <h5 class="card-title fw-bold">Ashley Castrillo</h5>
                        <p class="card-text text-uppercase small team-role-color">Asistente de Limpieza</p>
                        <p class="card-text description text-muted">
                            Fundamental para mantener un ambiente fresco y libre de gérmenes.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>