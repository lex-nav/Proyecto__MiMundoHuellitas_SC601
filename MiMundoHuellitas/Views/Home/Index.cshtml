@{
    ViewBag.Title = "Inicio - Mi Mundo de Huellitas";
    ViewBag.ActiveMenu = "Inicio";
}

<section class="hero-wrap d-flex align-items-center justify-content-center"
         style="background-image:url('/StaticFiles/img/bg_1.jpg');"
         data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="text-center text-white">
        <h1 class="hero-title mb-4">Mejor calidad para sus peludos</h1>
        <a href="#" class="btn btn-primary btn-lg px-4 py-3">Leer más</a>
    </div>
</section>

<section class="ftco-section bg-light ftco-no-pt ftco-intro">
    <div class="container">
        <div class="row">
            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services active text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-blind"></span>
                    </div>
                    <div class="media-body">
                        <h3 class="heading">Pet Grooming</h3>
                        <p>
                            Valoración del manto y asesoramiento de corte según la raza, baño y secado profesional,
                            deslanado o cepillado, perfume a escoger y accesorio decorativo.
                        </p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center">
                            <span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-dog-eating"></span>
                    </div>
                    <div class="media-body">
                        <h3 class="heading">Básicos</h3>
                        <p>
                            Ofrecemos servicios de higiene básico como corte higiénico, limpieza de orejas,
                            corte o limado de uñas.
                        </p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center">
                            <span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-flex align-self-stretch px-4 ftco-animate">
                <div class="d-block services text-center">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <span class="flaticon-grooming"></span>
                    </div>
                    <div class="media-body">
                        <h3 class="heading">Tintes</h3>
                        <p>
                            Los tintes en la estética canina se usan para realzar el color del pelaje y resaltar
                            la personalidad del perro de forma segura.
                        </p>
                        <a href="#" class="btn-custom d-flex align-items-center justify-content-center">
                            <span class="fa fa-chevron-right"></span><i class="sr-only">Read more</i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="ftco-section ftco-no-pt ftco-no-pb">
    <div class="container">
        <div class="row d-flex no-gutters">
            <div class="col-md-5 d-flex">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0"
                     style="background-image: url('/StaticFiles/img/about-1.jpg');">
                </div>
            </div>
            <div class="col-md-7 pl-md-5 py-md-5">
                <div class="heading-section pt-md-5">
                    <h2 class="mb-4">¿Por qué preferirnos?</h2>
                </div>
                <div class="row">
                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="flaticon-stethoscope"></span>
                        </div>
                        <div class="text pl-3">
                            <h4>Cuidado seguro</h4>
                            <p>Manejamos productos y técnicas amigables para tu mascota y atención profesional.</p>
                        </div>
                    </div>

                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="flaticon-customer-service"></span>
                        </div>
                        <div class="text pl-3">
                            <h4>Estilo personalizado</h4>
                            <p>Cada corte y color se adapta a la personalidad de tu perro.</p>
                        </div>
                    </div>

                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="flaticon-emergency-call"></span>
                        </div>
                        <div class="text pl-3">
                            <h4>Atención con amor</h4>
                            <p>Nuestro equipo trata a cada peludo como parte de la familia.</p>
                        </div>
                    </div>

                    <div class="col-md-6 services-2 w-100 d-flex">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="flaticon-veterinarian"></span>
                        </div>
                        <div class="text pl-3">
                            <h4>Resultados que enamoran</h4>
                            <p>Pelaje limpio, brillante y con estilo que destaca.</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-counter" id="section-counter">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="block-18 text-center">
                    <div class="text"><strong class="number" data-number="95">0</strong></div>
                    <div class="text"><span>Clientes</span></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="block-18 text-center">
                    <div class="text"><strong class="number" data-number="10">0</strong></div>
                    <div class="text"><span>Profesionales</span></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="block-18 text-center">
                    <div class="text"><strong class="number" data-number="50">0</strong></div>
                    <div class="text"><span>Productos</span></div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 d-flex justify-content-center counter-wrap ftco-animate">
                <div class="block-18 text-center">
                    <div class="text"><strong class="number" data-number="50">0</strong></div>
                    <div class="text"><span>Mascotas hospedadas</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light ftco-faqs">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 order-md-last">
                <div class="img img-video d-flex align-self-stretch align-items-center justify-content-center justify-content-md-center mb-4 mb-sm-0"
                     style="background-image: url('/StaticFiles/img/about.jpg');">
                    <a href="https://vimeo.com/45830194"
                       class="icon-video popup-vimeo d-flex justify-content-center align-items-center">
                        <span class="fa fa-play"></span>
                    </a>
                </div>
                <div class="d-flex mt-3">
                    <div class="img img-2 mr-md-2" style="background-image: url('/StaticFiles/img/about-2.jpg');"></div>
                    <div class="img img-2 ml-md-2" style="background-image: url('/StaticFiles/img/about-3.jpg');"></div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="heading-section mb-5 mt-5 mt-lg-0">
                    <h2 class="mb-3">Preguntas frecuentes</h2>
                    <p>
                        Aquí respondemos algunas de las dudas más comunes sobre el cuidado y
                        la estética de tu peludito.
                    </p>
                </div>

                <div id="accordion" class="myaccordion w-100" aria-multiselectable="true">
                    <div class="card">
                        <div class="card-header p-0" id="headingOne">
                            <h2 class="mb-0">
                                <button class="d-flex py-3 px-4 align-items-center justify-content-between btn btn-link"
                                        data-toggle="collapse" data-target="#collapseOne"
                                        aria-expanded="true" aria-controls="collapseOne">
                                    <p class="mb-0">¿Qué tipo de productos usan y son seguros para mi perro?</p>
                                    <i class="fa" aria-hidden="true"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse show" id="collapseOne" role="tabpanel" aria-labelledby="headingOne">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Usamos productos profesionales de estética canina.</li>
                                    <li>Elegimos shampoo según tipo de piel y pelaje.</li>
                                    <li>Evitamos componentes agresivos o irritantes.</li>
                                    <li>Probamos los productos previamente en nuestro equipo.</li>
                                    <li>Siempre te informamos qué usamos con tu peludito.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0" id="headingTwo">
                            <h2 class="mb-0">
                                <button class="d-flex py-3 px-4 align-items-center justify-content-between btn btn-link"
                                        data-toggle="collapse" data-target="#collapseTwo"
                                        aria-expanded="false" aria-controls="collapseTwo">
                                    <p class="mb-0">¿Con qué frecuencia debo bañar o cortar a mi mascota?</p>
                                    <i class="fa" aria-hidden="true"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse" id="collapseTwo" role="tabpanel" aria-labelledby="headingTwo">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Depende del tipo de pelaje y estilo de vida.</li>
                                    <li>En promedio, cada 3 a 6 semanas es una buena frecuencia.</li>
                                    <li>Para pelajes largos, se recomienda mantenimiento más seguido.</li>
                                    <li>Te asesoramos según la raza y necesidades de tu perro.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0" id="headingThree">
                            <h2 class="mb-0">
                                <button class="d-flex py-3 px-4 align-items-center justify-content-between btn btn-link"
                                        data-toggle="collapse" data-target="#collapseThree"
                                        aria-expanded="false" aria-controls="collapseThree">
                                    <p class="mb-0">¿Pueden teñir o estilizar el pelaje de forma segura?</p>
                                    <i class="fa" aria-hidden="true"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse" id="collapseThree" role="tabpanel" aria-labelledby="headingThree">
                            <div class="card-body py-3 px-0">
                                <ol>
                                    <li>Utilizamos tintes especiales para mascotas, no humanos.</li>
                                    <li>Siempre evaluamos primero la condición de la piel.</li>
                                    <li>Te explicamos el proceso y sus cuidados posteriores.</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header p-0" id="headingFour">
                            <h2 class="mb-0">
                                <button class="d-flex py-3 px-4 align-items-center justify-content-between btn btn-link"
                                        data-toggle="collapse" data-target="#collapseFour"
                                        aria-expanded="false" aria-controls="collapseFour">
                                    <p class="mb-0">¿Aceptan perros con piel sensible o problemas de salud?</p>
                                    <i class="fa" aria-hidden="true"></i>
                                </button>
                            </h2>
                        </div>
                        <div class="collapse" id="collapseFour" role="tabpanel" aria-labelledby="headingFour">
                            <div class="card-body py-3 px-0">
                                <p>
                                    Sí, pero siempre recomendamos consultar primero con tu
                                    veterinario de confianza. Adaptamos los productos y el
                                    tiempo del servicio según lo que tu peludito necesite.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section testimony-section"
         style="background-image: url('/StaticFiles/img/bg_2.jpg');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row justify-content-center pb-5 mb-3">
            <div class="col-md-7 heading-section text-center ftco-animate">
                <h2>Clientes felices &amp; feedbacks</h2>
            </div>
        </div>
        <div class="row ftco-animate">
            <div class="col-md-12">
                <div class="carousel-testimony owl-carousel ftco-owl">
                    <div class="item">
                        <div class="testimony-wrap py-4">
                            <div class="icon d-flex align-items-center justify-content-center">
                                <span class="fa fa-quote-left"></span>
                            </div>
                            <div class="text">
                                <p class="mb-4">
                                    “10 de 10! Excelente servicio, mi cachorra quedó divina
                                    y la atención fue muy buena. ¡Recomendadísimo!”
                                </p>
                                <div class="d-flex align-items-center">
                                    <div class="user-img"
                                         style="background-image: url('/StaticFiles/img/person_1.jpg')"></div>
                                    <div class="pl-3">
                                        <p class="name">Cliente real</p>
                                        <span class="position">Reseña en redes sociales</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="item">
                        <div class="testimony-wrap py-4">
                            <div class="icon d-flex align-items-center justify-content-center">
                                <span class="fa fa-quote-left"></span>
                            </div>
                            <div class="text">
                                <p class="mb-4">
                                    “Totalmente recomendado, llevé a mi cachorrito de 4 meses
                                    y lo trataron con mucho amor y paciencia.”
                                </p>
                                <div class="d-flex align-items-center">
                                    <div class="user-img"
                                         style="background-image: url('/StaticFiles/img/person_2.jpg')"></div>
                                    <div class="pl-3">
                                        <p class="name">Cliente real</p>
                                        <span class="position">Reseña en redes sociales</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="item">
                        <div class="testimony-wrap py-4">
                            <div class="icon d-flex align-items-center justify-content-center">
                                <span class="fa fa-quote-left"></span>
                            </div>
                            <div class="text">
                                <p class="mb-4">
                                    “Excelente servicio, súper amables, ¡mi gordito quedó guapísimo!”
                                </p>
                                <div class="d-flex align-items-center">
                                    <div class="user-img"
                                         style="background-image: url('/StaticFiles/img/person_3.jpg')"></div>
                                    <div class="pl-3">
                                        <p class="name">Cliente real</p>
                                        <span class="position">Reseña en redes sociales</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- más items si querés -->
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Loader (lo dejamos por si querés, pero el layout lo fuerza hidden si falla JS) -->
<div id="ftco-loader" class="show fullscreen">
    <svg class="circular" width="48px" height="48px">
        <circle class="path-bg" cx="24" cy="24" r="22"
                fill="none" stroke-width="4" stroke="#eeeeee" />
        <circle class="path" cx="24" cy="24" r="22"
                fill="none" stroke-width="4" stroke-miterlimit="10"
                stroke="#F96D00" />
    </svg>
</div>

