@{
    ViewBag.Title = "Servicios - Mi Mundo de Huellitas";
    ViewBag.ActiveMenu = "Servicios";
}

<!-- HERO SERVICIOS -->
<div class="hero-section d-flex align-items-center text-white"
     style="height: 260px;
            background: linear-gradient(rgba(10,123,72,0.80), rgba(14,118,140,0.80)),
                        url('/StaticFiles/img/bg_3.jpg') center/cover no-repeat;">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Nuestros Servicios</h1>
        <p class="lead mb-0">
            Grooming profesional, spa, tintes seguros y cuidados completos para consentir a tu peludito.
        </p>
    </div>
</div>

<div class="container my-5">

    <!-- INTRO + PUNTOS CLAVE -->
    <div class="row mb-4">
        <div class="col-lg-8 mx-auto text-center">
            <h2 class="h4 mb-3" style="color:#0A7B48;">Todo lo que tu mascota necesita en un solo lugar</h2>
            <p class="text-muted mb-0">
                En Mi Mundo de Huellitas combinamos técnicas profesionales de estética canina con un trato
                lleno de cariño y paciencia. Cada servicio está pensado para que tu peludito se sienta cómodo,
                seguro y salga más guapo que nunca.
            </p>
        </div>
    </div>

    <!-- TRES PÍLDORAS RÁPIDAS -->
    <div class="row mb-5">

        <!-- Trato con amor -->
        <div class="col-md-4 mb-5 card-1">
            <div class="h-100"
                 style="background: linear-gradient(135deg, #0A7B48, #0E768C);
                    border-radius: 22px;
                    padding: 3px;">
                <div class="text-center h-100"
                     style="background:#ffffff;
                        border-radius: 20px;
                        padding: 22px 20px;
                        box-shadow: 0 12px 30px rgba(0,0,0,0.08);">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width:56px;height:56px;border-radius:50%;
                            background:rgba(14,118,140,0.08);">
                        <span class="fa fa-heart" style="font-size:26px;color:#0E768C;"></span>
                    </div>
                    <h3 class="h5">Trato con amor</h3>
                    <p class="text-muted mb-0">
                        Manejo respetuoso, pausas cuando es necesario y mucha paciencia,
                        sobre todo con perritos nerviosos o primerizos.
                    </p>
                </div>
            </div>
        </div>

        <!-- Productos seguros -->
        <div class="col-md-4 mb-3 card-2">
            <div class="h-100"
                 style="background: linear-gradient(135deg, #0E768C, #18A999);
                    border-radius: 22px;
                    padding: 3px;">
                <div class="text-center h-100"
                     style="background:#ffffff;
                        border-radius: 20px;
                        padding: 22px 20px;
                        box-shadow: 0 12px 30px rgba(0,0,0,0.08);">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width:56px;height:56px;border-radius:50%;
                            background:rgba(24,169,153,0.08);">
                        <span class="fa fa-medkit" style="font-size:26px;color:#0E768C;"></span>
                    </div>
                    <h3 class="h5">Productos seguros</h3>
                    <p class="text-muted mb-0">
                        Usamos productos profesionales diseñados para mascotas, elegidos
                        según el tipo de piel y pelaje de tu peludito.
                    </p>
                </div>
            </div>
        </div>

        <!-- Resultados que enamoran -->
        <div class="col-md-4 mb-3 card-3">
            <div class="h-100"
                 style="background: linear-gradient(135deg, #FF9472, #F2709C);
                    border-radius: 22px;
                    padding: 3px;">
                <div class="text-center h-100"
                     style="background:#ffffff;
                        border-radius: 20px;
                        padding: 22px 20px;
                        box-shadow: 0 12px 30px rgba(0,0,0,0.08);">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width:56px;height:56px;border-radius:50%;
                            background:rgba(242,112,156,0.08);">
                        <span class="fa fa-picture-o" style="font-size:26px;color:#F2709C;"></span>
                    </div>
                    <h3 class="h5">Resultados que enamoran</h3>
                    <p class="text-muted mb-0">
                        Cortes, baños y estilos pensados para que salga listo para sus fotos
                        y para recibir mimos en casa.
                    </p>
                </div>
            </div>
        </div>

    </div>



    <!-- BLOQUE CÓMO TRABAJAMOS + AGENDA -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="service-card h-100">
                <h3 class="h5 mb-3">¿Cómo trabajamos?</h3>
                <ul class="list-unstyled mb-0 text-muted">
                    <li class="mb-2">
                        <span class="fa fa-check text-success me-2"></span>
                        Valoración inicial del pelaje, piel y comportamiento.
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-check text-success me-2"></span>
                        Selección de productos según tipo de pelaje y necesidades.
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-check text-success me-2"></span>
                        Trabajo por etapas para que tu peludo se sienta tranquilo.
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-check text-success me-2"></span>
                        Entrega con recomendaciones de cuidado en casa.
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="service-cta-band h-100 d-flex flex-column justify-content-between">
                <div>
                    <h3 class="h5 mb-3">Agenda y paquetes</h3>
                    <p class="mb-2">
                        Trabajamos con agenda previa para garantizar que cada peludito tenga
                        el tiempo y la atención que se merece.
                    </p>
                    <p class="mb-3">
                        Contamos con paquetes básicos, intermedios y premium que combinan
                        baño, corte, spa y servicios adicionales.
                    </p>
                </div>
                <div>
                    <a href="@Url.Action("Contacto","Home")" class="btn btn-light btn-sm">
                        Consultar disponibilidad
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- GRID DE SERVICIOS PRINCIPALES -->
    <div class="row mb-4">
        <div class="col-12 text-center mb-3">
            <h2 class="h4">Servicios principales</h2>
            <p class="text-muted mb-0">
                Podés elegir un servicio individual o combinarlos dentro de un paquete.
            </p>
        </div>
    </div>

    <div class="row">

        <!-- Grooming completo -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-grooming"></span>
                </div>
                <h3 class="heading mb-2">Grooming completo</h3>
                <p class="text-muted mb-3">
                    Baño, secado profesional, corte según raza o a gusto, perfume
                    y accesorio decorativo para fotos perfectas.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Valoración del manto y piel</li>
                    <li>Corte a máquina o tijera</li>
                    <li>Estilizado final</li>
                </ul>
                <span class="service-badge bg-success text-white">
                    Ideal para mantenimiento mensual
                </span>
            </div>
        </div>

        <!-- Baño & Spa -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-dog-eating"></span>
                </div>
                <h3 class="heading mb-2">Baño &amp; Spa</h3>
                <p class="text-muted mb-3">
                    Baño relajante con agua templada, shampoo adecuado, masaje,
                    cepillado y productos que dejan el pelaje suave y brillante.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Baño profundo y doble enjuague</li>
                    <li>Acondicionador hidratante</li>
                    <li>Aromas suaves y agradables</li>
                </ul>
                <span class="service-badge bg-info text-dark">
                    Perfecto entre cortes
                </span>
            </div>
        </div>

        <!-- Higiene básica -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-dog-with-scarf-and-bells"></span>
                </div>
                <h3 class="heading mb-2">Higiene básica</h3>
                <p class="text-muted mb-3">
                    Corte higiénico en zonas delicadas, limpieza de orejas, corte
                    o limado de uñas y revisión rápida del pelaje.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Corte higiénico</li>
                    <li>Orejas limpias</li>
                    <li>Uñas seguras y cortas</li>
                </ul>
                <span class="service-badge bg-warning text-dark">
                    Recomendado cada pocas semanas
                </span>
            </div>
        </div>

        <!-- Tintes y color -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-dog"></span>
                </div>
                <h3 class="heading mb-2">Tintes &amp; estilos</h3>
                <p class="text-muted mb-3">
                    Toques de color divertidos y seguros, utilizando productos aptos para mascotas
                    y zonas permitidas.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Evaluación previa de piel</li>
                    <li>Colores temporales</li>
                    <li>Estilos personalizados</li>
                </ul>
                <span class="service-badge bg-danger text-white">
                    Sujeto a evaluación
                </span>
            </div>
        </div>

        <!-- Paquetes combinados -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-pet"></span>
                </div>
                <h3 class="heading mb-2">Paquetes combinados</h3>
                <p class="text-muted mb-3">
                    Combina baño, corte, higiene y extras en paquetes básico, intermedio
                    o premium para mantener a tu peludo siempre cuidado.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Paquete Básico</li>
                    <li>Paquete Intermedio</li>
                    <li>Paquete Premium</li>
                </ul>
                <span class="service-badge bg-primary text-white">
                    Mejor valor por visita
                </span>
            </div>
        </div>

        <!-- Servicios adicionales -->
        <div class="col-md-4 d-flex mb-4">
            <div class="service-card text-center">
                <div class="icon-circle">
                    <span class="flaticon-emergency-call"></span>
                </div>
                <h3 class="heading mb-2">Servicios adicionales</h3>
                <p class="text-muted mb-3">
                    Según agenda y disponibilidad, coordinamos servicios especiales como transporte
                    o cuidados extra para ocasiones específicas.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li>Transporte (según zona)</li>
                    <li>Accesorios especiales</li>
                    <li>Recomendaciones personalizadas</li>
                </ul>
                <span class="service-badge bg-secondary text-white">
                    Consultar condiciones
                </span>
            </div>
        </div>
    </div>

    <!-- PASOS DEL SERVICIO -->
    <div class="row mt-4 mb-5">
        <div class="col-12">
            <div style="background: linear-gradient(135deg,
                                               rgba(10,123,72,0.06),
                                               rgba(14,118,140,0.10));
                    border-radius: 28px;
                    padding: 28px 24px 18px;">
                <div class="text-center mb-4">
                    <h2 class="h4 mb-1">¿Cómo es la experiencia de tu peludo?</h2>
                    <p class="text-muted mb-0">
                        Queremos que cada visita sea tranquila para él y sencilla para vos.
                    </p>
                </div>

                <div class="row">
                    <!-- Paso 1 -->
                    <div class="col-md-4 text-center mb-3">
                        <div class="mx-auto mb-2 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;border-radius:50%;
                                background:#ffffff;border:2px solid #0E768C;
                                font-weight:700;color:#0E768C;
                                box-shadow:0 6px 15px rgba(0,0,0,0.08);">
                            1
                        </div>
                        <div class="mb-2">
                            <span class="fa fa-phone fa-2x" style="color:#0A7B48;"></span>
                        </div>
                        <h5 class="mb-2">Reserva</h5>
                        <p class="small text-muted mb-0">
                            Nos contactás por WhatsApp o redes para agendar el día y la hora.
                        </p>
                    </div>

                    <!-- Paso 2 -->
                    <div class="col-md-4 text-center mb-3">
                        <div class="mx-auto mb-2 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;border-radius:50%;
                                background:#ffffff;border:2px solid #0E768C;
                                font-weight:700;color:#0E768C;
                                box-shadow:0 6px 15px rgba(0,0,0,0.08);">
                            2
                        </div>
                        <div class="mb-2">
                            <span class="fa fa-bath fa-2x" style="color:#0A7B48;"></span>
                        </div>
                        <h5 class="mb-2">Servicio</h5>
                        <p class="small text-muted mb-0">
                            Tu peludito recibe el servicio con calma, cariño y tiempo suficiente.
                        </p>
                    </div>

                    <!-- Paso 3 -->
                    <div class="col-md-4 text-center mb-3">
                        <div class="mx-auto mb-2 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;border-radius:50%;
                                background:#ffffff;border:2px solid #0E768C;
                                font-weight:700;color:#0E768C;
                                box-shadow:0 6px 15px rgba(0,0,0,0.08);">
                            3
                        </div>
                        <div class="mb-2">
                            <span class="fa fa-heart fa-2x" style="color:#0A7B48;"></span>
                        </div>
                        <h5 class="mb-2">Entrega feliz</h5>
                        <p class="small text-muted mb-0">
                            Te lo entregamos limpio, guapo y con recomendaciones para el hogar.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
