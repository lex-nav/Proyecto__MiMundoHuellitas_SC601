@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Productos";
}

<div class="container my-4">
    <h1 class="mb-3">Productos</h1>

    <p>Aquí puedes mostrar los productos disponibles para mascotas, como alimentos, snacks, accesorios, juguetes, collares, cepillos, ropa y más.</p>

    <div class="row g-4 mt-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="~/StaticFiles/img/producto1.jpg" class="card-img-top" alt="Producto 1">
                <div class="card-body">
                    <h5 class="card-title">Alimento Premium</h5>
                    <p class="card-text">Nutrición completa para perros de todas las edades.</p>
                    <button class="btn btn-success">Ver más</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="~/StaticFiles/img/producto2.jpg" class="card-img-top" alt="Producto 2">
                <div class="card-body">
                    <h5 class="card-title">Shampoo Antipulgas</h5>
                    <p class="card-text">Protección efectiva para la piel y pelaje.</p>
                    <button class="btn btn-success">Ver más</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="~/StaticFiles/img/producto3.jpg" class="card-img-top" alt="Producto 3">
                <div class="card-body">
                    <h5 class="card-title">Juguete Mordedera</h5>
                    <p class="card-text">Ideal para perros activos que necesitan entretenerse.</p>
                    <button class="btn btn-success">Ver más</button>
                </div>
            </div>
        </div>

    </div>
</div>
