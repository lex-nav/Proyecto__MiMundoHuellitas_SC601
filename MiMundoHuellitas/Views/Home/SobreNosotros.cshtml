@{
    ViewBag.Title = "Sobre Nosotros - Mi Mundo de Huellitas";
}

<!-- HERO CON ANIMACIONES -->
<div class="hero-section d-flex align-items-center text-white">

    <!-- Patitas animadas -->
    <div class="paws-animated-bg">
        <span class="paw paw-1"><i class="fa fa-paw"></i></span>
        <span class="paw paw-2"><i class="fa fa-paw"></i></span>
        <span class="paw paw-3"><i class="fa fa-paw"></i></span>
        <span class="paw paw-4"><i class="fa fa-paw"></i></span>
        <span class="paw paw-5"><i class="fa fa-paw"></i></span>
    </div>

    <div class="container text-center hero-content">
        <h1 class="display-4 fw-bold text-shadow mb-3">Mi Mundo de Huellitas</h1>
        <p class="lead text-shadow mb-4">
            Un lugar donde cada peludito recibe amor, cuidado y mucho estilo.
        </p>

        <div class="hero-tags d-flex justify-content-center flex-wrap gap-2">
            <span class="tag-pill"><i class="fa fa-scissors"></i> Grooming Profesional</span>
            <span class="tag-pill"><i class="fa fa-bath"></i> Baños Premium</span>
            <span class="tag-pill"><i class="fa fa-heart"></i> Ambiente Seguro y Cariñoso</span>
        </div>
    </div>
</div>

<div class="container mt-5">
    <!-- SECCIÓN QUIÉNES SOMOS -->
    <section class="about-section container my-5">
        <div class="row align-items-center">

            <div class="col-md-7">
                <h2 class="about-title">¿Quiénes Somos?</h2>

                <p class="about-text">
                    En <strong>Mi Mundo de Huellitas</strong> creemos que cada mascota es un miembro muy especial de la familia.
                    Somos una peluquería canina especializada en estética, bienestar y cuidado profesional.
                </p>

                <p class="about-text">
                    Brindamos un ambiente seguro, tranquilo y lleno de cariño, utilizando productos de alta calidad
                    y ofreciendo siempre un trato amable y respetuoso.
                </p>
            </div>

            <div class="col-md-5 text-center">
                <div class="about-image-frame">
                    <img src="~/StaticFiles/img/mundo.jpg" class="img-fluid" alt="Peluquería Canina">
                    <span class="about-badge">Pet Lovers 🐾</span>
                </div>
            </div>

        </div>
    </section>


    <!-- MISIÓN, VISIÓN Y VALORES – NUEVO DISEÑO -->
    <div class="section-colored my-5">

        <!-- MISIÓN Y VISIÓN -->
        <div class="row text-center mb-5">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="info-card">
                    <h2 class="section-colored-title mb-3">Nuestra Misión</h2>
                    <p>
                        Brindar servicios de estética y bienestar para mascotas, garantizando su comodidad,
                        felicidad y seguridad en todo momento.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <h2 class="section-colored-title mb-3">Nuestra Visión</h2>
                    <p>
                        Ser reconocidos como la peluquería canina favorita de la comunidad,
                        destacando por la excelencia, el amor por los animales y el trato humano.
                    </p>
                </div>
            </div>
        </div>

        <!-- VALORES -->
        <h2 class="section-colored-title text-center mb-4">Nuestros Valores</h2>

        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="valor-card">
                    <h5>Amor</h5>
                    <p class="small mb-0">Amamos lo que hacemos y a cada peludito que nos visita.</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="valor-card">
                    <h5>Respeto</h5>
                    <p class="small mb-0">Cuidamos su bienestar físico y emocional en todo momento.</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="valor-card">
                    <h5>Cuidado</h5>
                    <p class="small mb-0">Trabajamos con paciencia, cariño y productos adecuados.</p>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="valor-card">
                    <h5>Calidad</h5>
                    <p class="small mb-0">Buscamos resultados profesionales y experiencias felices.</p>
                </div>
            </div>
        </div>

    </div>
    <!-- FIN MISIÓN / VISIÓN / VALORES -->
    <!-- FOOTER -->
    <div class="footer-simple mt-5">
        <p class="mb-0 text-center text-white">
            © 2025 Mi Mundo de Huellitas – Todos los derechos reservados
        </p>
    </div>


