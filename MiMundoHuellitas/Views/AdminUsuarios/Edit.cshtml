@model MiMundoHuellitas.EF.MH_Usuario_TB

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

@using (Html.BeginForm("Edit", "AdminUsuarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdUsuario)

    <div class="mb-3">
        @Html.LabelFor(m => m.NombreCompleto)
        @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Correo)
        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Telefono)
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> Guardar
    </button>

    <a href="@Url.Action("Index")" class="btn btn-secondary">
        Cancelar
    </a>
}
