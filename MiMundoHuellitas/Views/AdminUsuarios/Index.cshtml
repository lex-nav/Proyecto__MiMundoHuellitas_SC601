
@model IEnumerable<MiMundoHuellitas.EF.MH_Usuario_TB>

@{
    ViewBag.Title = "Administrar Usuarios";
}

<h3 class="mb-3">Usuarios</h3>

<!-- AQUÍ VA LA TABLA -->
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.NombreCompleto</td>
                <td>@u.Correo</td>
                <td>@u.Telefono</td>
                <td>
                    <a href="@Url.Action("Edit","AdminUsuarios", new { id = u.IdUsuario })"
                       class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                    </a>

                    <a href="@Url.Action("Delete","AdminUsuarios", new { id = u.IdUsuario })"
                       class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>